auto_commit_text = pending.get(
    auto_commit_path, auto_commit_path.read_text(encoding="utf-8")
)
auto_commit_v091_cleanup = "            message_file.unlink()"
auto_commit_hardened_cleanup = (
    "            # Caller owns and cleans up the transport file; never delete it here."
)
auto_commit_cleanup_counts = {
    form: auto_commit_text.count(form)
    for form in (auto_commit_v091_cleanup, auto_commit_hardened_cleanup)
}
if (
    auto_commit_cleanup_counts[auto_commit_hardened_cleanup] == 1
    and sum(auto_commit_cleanup_counts.values()) == 1
):
    pass
elif (
    auto_commit_cleanup_counts[auto_commit_hardened_cleanup] == 0
    and sum(auto_commit_cleanup_counts.values()) == 1
):
    replace(
        ".specify/extensions/git/scripts/python/auto_commit.py",
        auto_commit_v091_cleanup,
        auto_commit_hardened_cleanup,
    )
else:
    raise SystemExit(
        "speckit-bootstrap: upstream artifact changed; Python auto-commit cleanup form is unknown"
    )

