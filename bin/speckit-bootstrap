sha256_path() {
  python3 - "$1" <<'PY'
import hashlib
import sys
from pathlib import Path

digest = hashlib.sha256()
with Path(sys.argv[1]).open("rb") as handle:
    for chunk in iter(lambda: handle.read(1024 * 1024), b""):
        digest.update(chunk)
print(digest.hexdigest())
PY
}

tree_sha256() {
  python3 - "$1" <<'PY'
import hashlib
import os
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
if not root.is_dir():
    raise SystemExit(1)

digest = hashlib.sha256()


def add_field(value: bytes) -> None:
    digest.update(len(value).to_bytes(8, "big"))
    digest.update(value)


def visit(path: Path, relative: str) -> None:
    metadata = path.lstat()
    encoded_relative = relative.encode("utf-8", errors="surrogateescape")
    if stat.S_ISLNK(metadata.st_mode):
        digest.update(b"L")
        add_field(encoded_relative)
        add_field(os.readlink(path).encode("utf-8", errors="surrogateescape"))
        return
    if stat.S_ISDIR(metadata.st_mode):
        digest.update(b"D")
        add_field(encoded_relative)
        for child in sorted(path.iterdir(), key=lambda item: item.name):
            child_relative = child.name if not relative else f"{relative}/{child.name}"
            visit(child, child_relative)
        return
    if stat.S_ISREG(metadata.st_mode):
        digest.update(b"F")
        add_field(encoded_relative)
        add_field(b"1" if metadata.st_mode & 0o111 else b"0")
        add_field(str(metadata.st_size).encode("ascii"))
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                digest.update(chunk)
        return
    digest.update(b"O")
    add_field(encoded_relative)
    add_field(str(stat.S_IFMT(metadata.st_mode)).encode("ascii"))


visit(root, "")
print(digest.hexdigest())
PY
}

extension_tree_hash() {
  local name="$1"
  local path="$PROJECT_DIR/.specify/extensions/$name"
  [[ -d "$path" ]] || return 0
  tree_sha256 "$path"
}

capture_project_skills_state() {
  local skills="$PROJECT_DIR/.agents/skills"
  local d name digest
  local -a entries=()

  if [[ -L "$skills" ]]; then
    echo "speckit-bootstrap: project skills path must not be a symlink: $skills" >&2
    return 1
  fi
  for d in "$skills"/speckit-*; do
    [[ -e "$d" || -L "$d" ]] || continue
    name="$(basename "$d")"
    if [[ ! "$name" =~ ^speckit-[A-Za-z0-9._+-]+$ ]]; then
      echo "speckit-bootstrap: unsafe generated skill name: $name" >&2
      return 1
    fi
    if [[ -L "$d" || ! -d "$d" ]]; then
      echo "speckit-bootstrap: generated skill must be a real directory: $name" >&2
      return 1
    fi
    if [[ ! -f "$d/SKILL.md" ]]; then
      echo "speckit-bootstrap: generated skill is missing SKILL.md: $name" >&2
      return 1
    fi
    digest="$(tree_sha256 "$d")"
    entries+=("$name=$digest")
  done

  if [[ "${#entries[@]}" -eq 0 ]]; then
    echo "speckit-bootstrap: no project-local Spec Kit skills were captured" >&2
    return 1
  fi

  RESOLVED_PROJECT_SKILLS_MANIFEST="$(python3 - "${entries[@]}" <<'PY'
import json
import sys

manifest = {}
for item in sys.argv[1:]:
    name, separator, digest = item.partition("=")
    if not separator:
        raise SystemExit("speckit-bootstrap: invalid managed skill manifest entry")
    manifest[name] = digest
print(json.dumps(manifest, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
PY
)"
}

verify_project_skills() {
  local manifest="$RESOLVED_PROJECT_SKILLS_MANIFEST"
  local skills="$PROJECT_DIR/.agents/skills"
  local entries
  local name expected actual
  local errors=0

  if ! entries="$(python3 - "$manifest" "$skills" <<'PY'
import json
import re
import sys
from pathlib import Path

try:
    manifest = json.loads(sys.argv[1])
except json.JSONDecodeError as error:
    print(f"speckit-bootstrap: invalid project skills manifest: {error}", file=sys.stderr)
    raise SystemExit(1)
if not isinstance(manifest, dict) or not manifest:
    print("speckit-bootstrap: project skills manifest must be a non-empty object", file=sys.stderr)
    raise SystemExit(1)
root = Path(sys.argv[2])
if root.is_symlink() or not root.is_dir():
    print("speckit-bootstrap: project skills path must be a real directory", file=sys.stderr)
    raise SystemExit(1)
for name, digest in sorted(manifest.items()):
    if not re.fullmatch(r"speckit-[A-Za-z0-9._+-]+", name):
        print(f"speckit-bootstrap: unsafe managed skill name: {name}", file=sys.stderr)
        raise SystemExit(1)
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
        print(f"speckit-bootstrap: invalid managed skill digest: {name}", file=sys.stderr)
        raise SystemExit(1)
actual = sorted(path.name for path in root.iterdir() if path.name.startswith("speckit-"))
expected = sorted(manifest)
if actual != expected:
    missing = sorted(set(expected) - set(actual))
    unexpected = sorted(set(actual) - set(expected))
    if missing:
        print(f"speckit-bootstrap: doctor missing project skills: {', '.join(missing)}", file=sys.stderr)
    if unexpected:
        print(f"speckit-bootstrap: doctor found unrecorded project skills: {', '.join(unexpected)}", file=sys.stderr)
    raise SystemExit(1)
for name in expected:
    path = root / name
    if path.is_symlink() or not path.is_dir():
        print(f"speckit-bootstrap: project skill must be a real directory: {name}", file=sys.stderr)
        raise SystemExit(1)
for name, digest in sorted(manifest.items()):
    print(f"{name}\t{digest}")
PY
)"; then
    return 1
  fi

  while IFS=$'\t' read -r name expected; do
    [[ -n "$name" ]] || continue
    if [[ ! -d "$skills/$name" ]]; then
      echo "speckit-bootstrap: doctor missing project skill: $name" >&2
      errors=$((errors + 1))
      continue
    fi
    actual="$(tree_sha256 "$skills/$name")"
    if [[ "$actual" != "$expected" ]]; then
      echo "speckit-bootstrap: doctor found project skill drift: $name" >&2
      errors=$((errors + 1))
    fi
  done <<< "$entries"

  [[ "$errors" -eq 0 ]]
}

migrate_legacy_global_skills() {
  local lock
  lock="$(lock_file)"
  [[ -f "$lock" ]] || return 0
  [[ "$(read_lock_value "$lock" schema_version 2>/dev/null || true)" == "2" ]] || return 0

  local global_skills="$HOME/.agents/skills"
  local path found=0
  for path in "$global_skills"/speckit-*; do
    [[ -e "$path" || -L "$path" ]] || continue
    found=1
    break
  done
  [[ "$found" -eq 1 ]] || return 0

  echo "speckit-bootstrap: preserved legacy user-level skills at $global_skills/speckit-*" >&2
  echo "speckit-bootstrap: review and remove duplicates manually after schema v3 migration" >&2
}

capture_project_dependency_state() {
  local workflow="$PROJECT_DIR/.specify/workflows/speckit/workflow.yml"
  if [[ ! -f "$workflow" ]]; then
    echo "speckit-bootstrap: installed speckit workflow file is missing" >&2
    return 1
  fi

  RESOLVED_AGENT_CONTEXT_VERSION="$(extension_version agent-context)"
  RESOLVED_AGENT_CONTEXT_MANIFEST_HASH="$(extension_manifest_hash agent-context)"
  RESOLVED_AGENT_CONTEXT_TREE_SHA256="$(extension_tree_hash agent-context)"
  RESOLVED_GIT_EXTENSION_VERSION="$(extension_version git)"
  RESOLVED_GIT_EXTENSION_MANIFEST_HASH="$(extension_manifest_hash git)"
  RESOLVED_GIT_EXTENSION_TREE_SHA256="$(extension_tree_hash git)"
  RESOLVED_ISSUE_CANON_INSTALLED_VERSION="$(extension_version github-issue-canon)"
  RESOLVED_ISSUE_CANON_MANIFEST_HASH="$(extension_manifest_hash github-issue-canon)"
  RESOLVED_ISSUE_CANON_TREE_SHA256="$(extension_tree_hash github-issue-canon)"
  RESOLVED_WORKFLOW_VERSION="$(workflow_version)"
  RESOLVED_WORKFLOW_SHA256="$(sha256_path "$workflow")"
  RESOLVED_WORKFLOW_SOURCE="$(workflow_source)"

  if [[ -z "$RESOLVED_AGENT_CONTEXT_VERSION" || -z "$RESOLVED_AGENT_CONTEXT_MANIFEST_HASH" ||
        -z "$RESOLVED_AGENT_CONTEXT_TREE_SHA256" ||
        -z "$RESOLVED_GIT_EXTENSION_VERSION" || -z "$RESOLVED_GIT_EXTENSION_MANIFEST_HASH" ||
        -z "$RESOLVED_GIT_EXTENSION_TREE_SHA256" ||
        -z "$RESOLVED_ISSUE_CANON_INSTALLED_VERSION" || -z "$RESOLVED_ISSUE_CANON_MANIFEST_HASH" ||
        -z "$RESOLVED_ISSUE_CANON_TREE_SHA256" ||
        -z "$RESOLVED_WORKFLOW_VERSION" ||
        -z "$RESOLVED_WORKFLOW_SHA256" || -z "$RESOLVED_WORKFLOW_SOURCE" ]]; then
    echo "speckit-bootstrap: could not capture complete extension/workflow lock state" >&2
    return 1
  fi
}

verify_locked_extension() {
  local name="$1"
  local expected_version="$2"
  local expected_hash="$3"
  local expected_tree_hash="$4"
  local expected_skill="$5"
  local actual_version
  local actual_hash
  local actual_tree_hash

  actual_version="$(extension_version "$name")"
  actual_hash="$(extension_manifest_hash "$name")"
  actual_tree_hash="$(extension_tree_hash "$name")"
  if [[ "$actual_version" != "$expected_version" ||
        "$actual_hash" != "$expected_hash" ||
        "$actual_tree_hash" != "$expected_tree_hash" ]]; then
    echo "speckit-bootstrap: frozen $name extension does not match the lock" >&2
    echo "  expected: version=$expected_version manifest_hash=$expected_hash tree_sha256=$expected_tree_hash" >&2
    echo "  actual:   version=$actual_version manifest_hash=$actual_hash tree_sha256=$actual_tree_hash" >&2
    return 1
  fi
  if [[ ! -f "$PROJECT_DIR/$expected_skill" ]]; then
    echo "speckit-bootstrap: frozen $name extension skill is missing: $expected_skill" >&2
    return 1
  fi
}

verify_locked_workflow() {
  local workflow="$PROJECT_DIR/.specify/workflows/speckit/workflow.yml"
  local actual_version
  local actual_sha256
  local actual_source
  if [[ ! -f "$workflow" ]]; then
    echo "speckit-bootstrap: frozen speckit workflow file is missing" >&2
    return 1
  fi
  actual_version="$(workflow_version)"
  actual_sha256="$(sha256_path "$workflow")"
  actual_source="$(workflow_source)"
  if [[ "$actual_version" != "$RESOLVED_WORKFLOW_VERSION" ||
        "$actual_sha256" != "$RESOLVED_WORKFLOW_SHA256" ||
        "$actual_source" != "$RESOLVED_WORKFLOW_SOURCE" ]]; then
    echo "speckit-bootstrap: frozen speckit workflow does not match the lock" >&2
    echo "  expected: version=$RESOLVED_WORKFLOW_VERSION sha256=$RESOLVED_WORKFLOW_SHA256 source=$RESOLVED_WORKFLOW_SOURCE" >&2
    echo "  actual:   version=$actual_version sha256=$actual_sha256 source=$actual_source" >&2
    return 1
  fi
}

ensure_extension() {
  local name="$1"
  local expected_skill="${2:-}"
  local output

  if extension_installed "$name" && { [[ -z "$expected_skill" ]] || [[ -f "$PROJECT_DIR/$expected_skill" ]]; }; then
    return 0
  fi

  if output="$(specify extension add "$name" --force 2>&1)"; then
    printf '%s\n' "$output"
    return 0
  fi

  if printf '%s\n' "$output" | grep -Fq "already installed"; then
    return 0
  fi

  printf '%s\n' "$output" >&2
  return 1
}

ensure_extension_from_catalog() {
  local name="$1"
  local expected_version="${2#v}"
  local expected_skill="${3:-}"
  local output
  local installed_version
  local catalog_url="${RESOLVED_ISSUE_CANON_CATALOG_URL:-$YAN_EXTENSION_CATALOG_URL}"

  if ! output="$(SPECKIT_CATALOG_URL="$catalog_url" specify extension add "$name" --force 2>&1)"; then
    printf '%s\n' "$output" >&2
    return 1
  fi
  printf '%s\n' "$output"

  installed_version="$(extension_version "$name")"
  if [[ "$installed_version" != "$expected_version" ]]; then
    echo "speckit-bootstrap: catalog installed $name $installed_version, expected $expected_version" >&2
    return 1
  fi
  if [[ -n "$expected_skill" && ! -f "$PROJECT_DIR/$expected_skill" ]]; then
    echo "speckit-bootstrap: catalog install did not register $expected_skill" >&2
    return 1
  fi
}

ensure_extension_from_url() {
  local name="$1"
  local url="$2"
  local expected_version="${3:-}"
  local expected_skill="${4:-}"
  local output
  local installed_version

  installed_version="$(extension_version "$name")"
  if [[ -n "$expected_version" ]]; then
    expected_version="${expected_version#v}"
  fi
  if extension_installed "$name" && \
     { [[ -z "$expected_version" ]] || [[ "$installed_version" == "$expected_version" ]]; } && \
     { [[ -z "$expected_skill" ]] || [[ -f "$PROJECT_DIR/$expected_skill" ]]; }; then
    return 0
  fi

  if output="$(printf 'y\n' | specify extension add "$name" --from "$url" --force 2>&1)"; then
    printf '%s\n' "$output"
    return 0
  fi

  if printf '%s\n' "$output" | grep -Fq "already installed"; then
    return 0
  fi

  printf '%s\n' "$output" >&2
  return 1
}

ensure_agent_context_config() {
  local config="$PROJECT_DIR/.specify/extensions/agent-context/agent-context-config.yml"
  [[ -f "$config" ]] || return 0

  if grep -q '^context_file:' "$config"; then
    sed -i.bak 's#^context_file:.*#context_file: "AGENTS.md"#' "$config"
    rm -f "$config.bak"
  else
    local tmp
    tmp="$(mktemp)"
    printf 'context_file: "AGENTS.md"\n' > "$tmp"
    cat "$config" >> "$tmp"
    mv "$tmp" "$config"
  fi
}

configure_git_auto_commit() {
  local config="$PROJECT_DIR/.specify/extensions/git/git-config.yml"
  [[ -f "$config" ]] || return 0

  if ! command -v python3 >/dev/null 2>&1; then
    echo "speckit-bootstrap: python3 not found; skipped git auto-commit policy" >&2
    return 0
  fi

  python3 - "$config" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
lines = path.read_text(encoding="utf-8").splitlines()

enabled_after_doc_hooks = {
    "after_constitution",
    "after_specify",
    "after_clarify",
    "after_plan",
    "after_tasks",
    "after_checklist",
    "after_analyze",
}

auto_commit = False
current_hook = None
out = []

for line in lines:
    if line == "auto_commit:":
        auto_commit = True
        current_hook = None
        out.append(line)
        continue

    if auto_commit and line and not line.startswith(" "):
        auto_commit = False
        current_hook = None

    if auto_commit:
        hook_match = re.match(r"^  ([A-Za-z0-9_]+):(?:\s.*)?$", line)
        if hook_match:
            current_hook = hook_match.group(1)
            if current_hook == "default":
                out.append("  default: false")
                continue

        if current_hook and re.match(r"^    enabled:\s*(true|false)\s*$", line):
            enabled = "true" if current_hook in enabled_after_doc_hooks else "false"
            out.append(f"    enabled: {enabled}")
            continue

    out.append(line)

path.write_text("\n".join(out) + "\n", encoding="utf-8")
PY

  echo "speckit-bootstrap: configured safe Spec Kit git auto-commit policy"
}

ensure_github_agent_instructions() {
  local agents="$PROJECT_DIR/AGENTS.md"

  [[ -f "$agents" ]] || return 0

  if ! command -v python3 >/dev/null 2>&1; then
    echo "speckit-bootstrap: python3 not found; skipped GitHub issue instructions" >&2
    return 0
  fi

  python3 - "$agents" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8", errors="ignore")
start = "<!-- SPECKIT GITHUB ISSUE START -->"
end = "<!-- SPECKIT GITHUB ISSUE END -->"
block = f"""{start}
## Правила GitHub issues

- `tasks.md` остается источником правды по реализации.
- GitHub issues используются как внешний трекер выполнения, review, PR-связей и evidence.
- Canon: `docs/agent-guidance/github-issue-canon.md`.
- Все GitHub issue titles, issue bodies, PR descriptions, status comments, closure comments и sync notes по умолчанию пиши на русском.
- Пиши простым, понятным языком, чтобы текст был ясен не только инженерам, но и обычным участникам проекта.
- Для Spec Kit task-backed issues используй ровно один title format: `[<feature>][<priority>][<area>] T###: <русский результат>`.
- Не используй bare `T###: ...` titles в bootstrapped repositories с `github-issue-canon`; это fallback только для репозиториев без project canon.
- Не создавай дубли GitHub issues. Сначала ищи существующие issue по номеру фичи, task ID, ссылке и заголовку.
- В PR используй `Fixes #...`, `Closes #...` или `Resolves #...` только для issues, которые PR закрывает полностью; для частичной связи используй `Refs #...` или `Part of #...`.
- Когда задача отмечена `[X]` в `tasks.md`, закрывай соответствующий GitHub issue только после проверки evidence и добавляй подробный понятный closure comment: что закрыто, почему важно, как проверено, что не входит, какой PR и task закрыты.
- Если GitHub issue закрыт, но `tasks.md` еще открыт, сначала проверь реализацию и evidence, а не отмечай задачу выполненной молча.
{end}
"""
if start in text and end in text:
    text = re.sub(
        r"\n*<!-- SPECKIT GITHUB ISSUE START -->.*?<!-- SPECKIT GITHUB ISSUE END -->\n*",
        "\n\n" + block + "\n",
        text,
        flags=re.S,
    )
else:
    text = text.rstrip() + "\n\n" + block + "\n"
path.write_text(text.rstrip() + "\n", encoding="utf-8")
PY

  echo "speckit-bootstrap: ensured GitHub issue instructions in AGENTS.md"
}

ensure_release_versioning_instructions() {
  local agents="$PROJECT_DIR/AGENTS.md"

  [[ -f "$agents" ]] || return 0

  if ! command -v python3 >/dev/null 2>&1; then
    echo "speckit-bootstrap: python3 not found; skipped release/versioning instructions" >&2
    return 0
  fi

  python3 - "$agents" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8", errors="ignore")
start = "<!-- SPECKIT RELEASE VERSIONING START -->"
end = "<!-- SPECKIT RELEASE VERSIONING END -->"
block = f"""{start}
## Правила релизов и версий

- Каждый релиз должен иметь tag, GitHub Release и понятный русский changelog/release notes.
- Product apps, deployed services и release-train bundles версионируй через CalVer: `vYYYY.MM.DD.N`.
- Libraries, CLI tools, reusable Spec Kit extensions и bootstrap wrappers версионируй через SemVer: `vMAJOR.MINOR.PATCH`.
- Человекочитаемый postfix релиза пиши в GitHub Release title, не в stable tag: например `v2026.06.18.1 - release-rules`.
- Prerelease suffix используй только для настоящих prerelease: `-alpha.N`, `-beta.N`, `-rc.N`.
- Release notes должны быть на русском и содержать: что изменилось, validation evidence, compatibility/migration impact, known limitations и ссылки на PR/issues.
{end}
"""
if start in text and end in text:
    text = re.sub(
        r"\n*<!-- SPECKIT RELEASE VERSIONING START -->.*?<!-- SPECKIT RELEASE VERSIONING END -->\n*",
        "\n\n" + block + "\n",
        text,
        flags=re.S,
    )
elif "## Правила релизов и версий" in text:
    path.write_text(text.rstrip() + "\n", encoding="utf-8")
    raise SystemExit(0)
else:
    text = text.rstrip() + "\n\n" + block + "\n"
path.write_text(text.rstrip() + "\n", encoding="utf-8")
PY

  echo "speckit-bootstrap: ensured release/versioning instructions in AGENTS.md"
}

ensure_risk_lane_templates() {
  local templates="$PROJECT_DIR/.specify/templates"
  [[ -d "$templates" ]] || return 0

  if ! command -v python3 >/dev/null 2>&1; then
    echo "speckit-bootstrap: python3 not found; skipped risk-lane template guidance" >&2
    return 0
  fi

  python3 - "$templates" <<'PY'
import sys
from pathlib import Path

templates = Path(sys.argv[1])

plan = templates / "plan-template.md"
if not plan.is_file():
    raise SystemExit("speckit-bootstrap: generated plan-template.md is missing")
text = plan.read_text(encoding="utf-8")
if "**Risk / Validation Lane**:" not in text:
    text = text.replace(
            "**Testing**: [e.g., pytest, XCTest, cargo test or NEEDS CLARIFICATION]\n",
            "**Testing**: [e.g., pytest, XCTest, cargo test or NEEDS CLARIFICATION]\n\n"
            "**Risk / Validation Lane**: [read-only / docs-only / tiny-low-risk-code / active-spec-slice / significant-feature / high-risk-feature / release-deploy, with rationale]\n\n"
            "**Release Gate**: [no deploy / cd dry-run / cd execute, with rationale]\n",
    )
if "## Validation Plan" not in text:
    text = text.replace(
            "[Gates determined based on constitution file]\n",
            "[Gates determined based on constitution file]\n\n"
            "## Validation Plan\n\n"
            "[Name the focused checks, quickstart scenarios, repository gate, and deploy gate\n"
            "required by the selected lane. Explain why broader gates are not required when\n"
            "the lane is low risk.]\n",
    )
if "**Risk / Validation Lane**:" not in text or "## Validation Plan" not in text:
    raise SystemExit(
        "speckit-bootstrap: upstream plan-template.md changed; risk-lane anchors were not applied"
    )
plan.write_text(text, encoding="utf-8")

tasks = templates / "tasks-template.md"
if not tasks.is_file():
    raise SystemExit("speckit-bootstrap: generated tasks-template.md is missing")
text = tasks.read_text(encoding="utf-8")
text = text.replace(
        "**Tests**: The examples below include test tasks. Tests are OPTIONAL - only include them if explicitly requested in the feature specification.",
        "**Tests**: The examples below include test tasks. Include tests when explicitly\n"
        "requested in the feature specification or when the selected risk/validation lane\n"
        "requires them.",
)
text = text.replace(
        "### Tests for User Story 1 (OPTIONAL - only if tests requested) ⚠️",
        "### Tests for User Story 1 (if requested or lane-required) ⚠️",
)
text = text.replace(
        "### Tests for User Story 2 (OPTIONAL - only if tests requested) ⚠️",
        "### Tests for User Story 2 (if requested or lane-required) ⚠️",
)
text = text.replace(
        "### Tests for User Story 3 (OPTIONAL - only if tests requested) ⚠️",
        "### Tests for User Story 3 (if requested or lane-required) ⚠️",
)
text = text.replace(
        "- [ ] TXXX Run quickstart.md validation",
        "- [ ] TXXX Record the selected risk/validation lane and run the matching plan.md/quickstart.md checks",
)
text = text.replace(
        "- [ ] TXXX Record the selected validation lane and run the matching plan.md/quickstart.md checks",
        "- [ ] TXXX Record the selected risk/validation lane and run the matching plan.md/quickstart.md checks",
)
if "Record the selected risk/validation lane" not in text:
    raise SystemExit(
        "speckit-bootstrap: upstream tasks-template.md changed; risk-lane task was not applied"
    )
tasks.write_text(text, encoding="utf-8")
PY

  echo "speckit-bootstrap: ensured risk-lane guidance in Spec Kit templates"
}

ensure_issue_canon_project_files() {
  local extension="$PROJECT_DIR/.specify/extensions/github-issue-canon"
  [[ -d "$extension" ]] || {
    echo "speckit-bootstrap: github-issue-canon extension is missing" >&2
    return 1
  }

  python3 - "$PROJECT_DIR" "$extension" <<'PY'
import os
import sys
import tempfile
from pathlib import Path

root = Path(sys.argv[1])
extension = Path(sys.argv[2])
managed_marker = "<!-- managed-by: github-issue-canon -->"
changed = []
preserved = []


def atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
        os.replace(tmp_name, path)
    except BaseException:
        Path(tmp_name).unlink(missing_ok=True)
        raise


def install(rel_source: str, rel_target: str, refresh_managed: bool = False) -> None:
    source = extension / "templates" / rel_source
    target = root / rel_target
    content = source.read_text(encoding="utf-8")
    if not target.exists():
        atomic_write(target, content)
        changed.append(rel_target)
        return
    current = target.read_text(encoding="utf-8", errors="ignore")
    if current == content:
        return
    if refresh_managed and managed_marker in current:
        atomic_write(target, content)
        changed.append(rel_target)
        return
    preserved.append(rel_target)


install(
    "docs/agent-guidance/github-issue-canon.md",
    "docs/agent-guidance/github-issue-canon.md",
    refresh_managed=True,
)
install("github/ISSUE_TEMPLATE/config.yml", ".github/ISSUE_TEMPLATE/config.yml")
install(
    "github/ISSUE_TEMPLATE/spec-kit-work-item.yml",
    ".github/ISSUE_TEMPLATE/spec-kit-work-item.yml",
)
install("github/pull_request_template.md", ".github/pull_request_template.md")

if changed:
    print("speckit-bootstrap: installed/refreshed issue canon files:")
    for path in changed:
        print(f"  - {path}")
if preserved:
    print("speckit-bootstrap: preserved user-owned issue canon files:", file=sys.stderr)
    for path in preserved:
        print(f"  - {path}", file=sys.stderr)
PY
}

ensure_ponytail_agent_instructions() {
  [[ "$SKIP_PONYTAIL" -eq 0 ]] || return 0

  local agents="$PROJECT_DIR/AGENTS.md"

  [[ -f "$agents" ]] || return 0

  if ! command -v python3 >/dev/null 2>&1; then
    echo "speckit-bootstrap: python3 not found; skipped Ponytail instructions" >&2
    return 0
  fi

  python3 - "$agents" "$PONYTAIL_UPSTREAM_AGENTS_PATH" <<'PY'
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
upstream_path = sys.argv[2]
text = path.read_text(encoding="utf-8", errors="ignore")
start = "<!-- SPECKIT PONYTAIL START -->"
end = "<!-- SPECKIT PONYTAIL END -->"
upstream_line = f"- Upstream Ponytail `AGENTS.md` fallback обновляется в `{upstream_path}`; не копируй его в корневой `AGENTS.md` вручную.\n"
fallback_line = "- Если plugin hooks недоступны, используй upstream fallback-файл как справку по Ponytail, но приоритет корневого `AGENTS.md` и Spec Kit managed-блоков выше.\n"
block = f"""{start}
## Ponytail в Spec Kit

- Ponytail управляет формой реализации: меньше кода, меньше новых зависимостей, reuse/stdlib/native-first, минимальный рабочий diff.
- Ponytail не снижает выбранный risk/validation lane: low-risk lanes остаются scoped, а significant/high-risk lanes сохраняют specs, plan, checklists, tasks, analyze, taskstoissues, GitHub issues, PR evidence, release notes и closeout.
- Реальное поведение Ponytail приходит из установленного Codex plugin; этот блок описывает только границы применения внутри Spec Kit.
{upstream_line}{fallback_line}- На этапе реализации применяй Ponytail ladder после чтения реального потока: не строить лишнее, искать существующий helper/pattern, использовать stdlib/native, писать минимум кода, но сохранять security, accessibility, trust-boundary validation и проверки.
- Для сложного diff перед PR/merge запускай `@ponytail-review` и убирай найденное переусложнение, если это не ломает требования и evidence.
- Если оставляешь намеренное упрощение, помечай его `ponytail:` comment с потолком решения и trigger/upgrade path; периодически собирай такие места через `@ponytail-debt`.
- Если пользователь просит `@ponytail off`, `normal mode` или явно настаивает на полной версии, выполняй это без спора.
{end}
"""
if start in text and end in text:
    text = re.sub(
        r"\n*<!-- SPECKIT PONYTAIL START -->.*?<!-- SPECKIT PONYTAIL END -->\n*",
        "\n\n" + block + "\n",
        text,
        flags=re.S,
    )
else:
    text = text.rstrip() + "\n\n" + block + "\n"
path.write_text(text.rstrip() + "\n", encoding="utf-8")
PY

  echo "speckit-bootstrap: ensured Ponytail instructions in AGENTS.md"
}

run_agent_context_update() {
  local script="$PROJECT_DIR/.specify/extensions/agent-context/scripts/bash/update-agent-context.sh"
  [[ -x "$script" ]] || return 0

  local specify_bin
  local specify_tool_bin=""
  local specify_shebang=""
  local uv_specify_tool_bin="$HOME/.local/share/uv/tools/specify-cli/bin"
  specify_bin="$(command -v specify 2>/dev/null || true)"
  if [[ -n "$specify_bin" ]]; then
    specify_shebang="$(sed -n '1s/^#!//p' "$specify_bin")"
    if [[ -x "$specify_shebang" ]]; then
      specify_tool_bin="$(cd "$(dirname "$specify_shebang")" && pwd)"
    else
      specify_tool_bin="$(cd "$(dirname "$specify_bin")" && pwd)"
    fi
  fi

  if [[ -n "$specify_tool_bin" && -x "$specify_tool_bin/python3" ]]; then
    PATH="$specify_tool_bin:$PATH" "$script"
  elif [[ -x "$uv_specify_tool_bin/python3" ]]; then
    PATH="$uv_specify_tool_bin:$PATH" "$script"
  else
    "$script"
  fi
}

clean_caches() {
  rm -rf \
    "$PROJECT_DIR/.specify/extensions/.cache" \
    "$PROJECT_DIR/.specify/integrations/.cache" \
    "$PROJECT_DIR/.specify/workflows/.cache"
  rm -f "$PROJECT_DIR/.specify/.workflow-install.lock"
}

hide_install_metadata_diffs() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0

  local file changed=0
  for file in "${INSTALL_METADATA_PATHS[@]}"; do
    if git ls-files --error-unmatch "$file" >/dev/null 2>&1; then
      if [[ "$TRACK_INSTALL_METADATA" == "1" ]]; then
        git update-index --no-skip-worktree "$file"
      else
        git update-index --skip-worktree "$file"
      fi
      changed=1
    fi
  done

  if [[ "$changed" -eq 1 ]]; then
    if [[ "$TRACK_INSTALL_METADATA" == "1" ]]; then
      echo "speckit-bootstrap: exposed Spec Kit install metadata for audit/release diff"
    else
      echo "speckit-bootstrap: hid refresh-only Spec Kit install metadata from git diff"
    fi
  fi
}

hidden_install_metadata_drift() {
  git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0

  local file index_entry index_hash worktree_hash
  for file in "${INSTALL_METADATA_PATHS[@]}"; do
    index_entry="$(git -C "$PROJECT_DIR" ls-files -v -- "$file" 2>/dev/null || true)"
    [[ "$index_entry" == S\ * ]] || continue
    if [[ ! -f "$PROJECT_DIR/$file" ]]; then
      printf '%s\n' "$file"
      continue
    fi
    index_hash="$(git -C "$PROJECT_DIR" ls-files --stage -- "$file" | awk 'NR == 1 {print $2}')"
    worktree_hash="$(git -C "$PROJECT_DIR" hash-object --path="$file" -- "$file" 2>/dev/null || true)"
    if [[ -z "$index_hash" || -z "$worktree_hash" || "$index_hash" != "$worktree_hash" ]]; then
      printf '%s\n' "$file"
    fi
  done
}

explain_hidden_install_metadata_drift() {
  local drift
  drift="$(hidden_install_metadata_drift)"
  [[ -n "$drift" ]] || return 0

  echo "speckit-bootstrap: doctor found drift hidden from git status by skip-worktree:" >&2
  while IFS= read -r path; do
    printf '  - %s\n' "$path" >&2
  done <<< "$drift"
  echo "speckit-bootstrap: audit with: SPECKIT_TRACK_INSTALL_METADATA=1 speckit-bootstrap . --doctor" >&2
}

ensure_codex_integration() {
  local status_output
  status_output="$(specify integration status 2>&1 || true)"

  if printf '%s\n' "$status_output" | grep -Fq "No integration currently installed"; then
    echo "speckit-bootstrap: installing Codex integration in $PROJECT_DIR"
    specify integration install codex --integration-options="--skills"
    return
  fi

  if printf '%s\n' "$status_output" | grep -Fq "Integration 'codex' is not installed"; then
    echo "speckit-bootstrap: installing Codex integration in $PROJECT_DIR"
    specify integration install codex --integration-options="--skills"
    return
  fi

  specify integration upgrade codex --integration-options="--skills"
}

init_spec_kit_project() {
  local -a args
  args=(init --here --integration codex --script sh --force)
  if ! command -v codex >/dev/null 2>&1; then
    args+=(--ignore-agent-tools)
  fi

  SPECIFY_INIT_DIR="$PROJECT_DIR" specify "${args[@]}"
}

refresh_speckit_workflow() {
  local workflow="$PROJECT_DIR/.specify/workflows/speckit/workflow.yml"
  local expected_source
  local current_source
  local locked_sha256=""
  local actual_sha256=""
  local output

  expected_source="$(resolved_workflow_url)"
  current_source="$(workflow_source)"
  if [[ -f "$workflow" && -f "$(lock_file)" && "$current_source" == "$expected_source" ]]; then
    locked_sha256="$(read_lock_value "$(lock_file)" workflow.sha256 2>/dev/null || true)"
    actual_sha256="$(sha256_path "$workflow")"
    if [[ -n "$locked_sha256" && "$actual_sha256" == "$locked_sha256" ]]; then
      echo "speckit-bootstrap: speckit workflow already matches immutable source $RESOLVED_SPEC_KIT_REF"
      return 0
    fi
  fi

  if ! output="$(printf 'y\n' | specify workflow add speckit --from "$expected_source" 2>&1)"; then
    printf '%s\n' "$output" >&2
    return 1
  fi
  printf '%s\n' "$output"
  if [[ "$(workflow_source)" != "$expected_source" ]]; then
    echo "speckit-bootstrap: workflow registry did not record the immutable source" >&2
    return 1
  fi
}

write_lock_file() {
  if [[ "$FROZEN" -eq 1 ]]; then
    echo "speckit-bootstrap: frozen mode preserved the existing reproducibility lock"
    return 0
  fi

  local path
  path="$(lock_file)"
  local ponytail_enabled=true
  local ponytail_version="$RESOLVED_PONYTAIL_VERSION"
  local ponytail_ref="$RESOLVED_PONYTAIL_REF"
  local ponytail_marketplace_sha256="$RESOLVED_PONYTAIL_MARKETPLACE_SHA256"
  if [[ "$SKIP_PONYTAIL" -eq 1 ]]; then
    ponytail_enabled=false
    ponytail_version="disabled"
    ponytail_ref="disabled"
    ponytail_marketplace_sha256="disabled"
  fi

  python3 - \
    "$path" \
    "$BOOTSTRAP_VERSION" \
    "$RESOLVED_SPEC_KIT_VERSION" \
    "$RESOLVED_SPEC_KIT_REF" \
    "$RESOLVED_ISSUE_CANON_VERSION" \
    "$RESOLVED_ISSUE_CANON_REF" \
    "$RESOLVED_ISSUE_CANON_INSTALLED_VERSION" \
    "$RESOLVED_ISSUE_CANON_URL" \
    "$RESOLVED_ISSUE_CANON_ARCHIVE_SHA256" \
    "$RESOLVED_ISSUE_CANON_MANIFEST_HASH" \
    "$RESOLVED_ISSUE_CANON_TREE_SHA256" \
    "$RESOLVED_AGENT_CONTEXT_VERSION" \
    "$RESOLVED_AGENT_CONTEXT_MANIFEST_HASH" \
    "$RESOLVED_AGENT_CONTEXT_TREE_SHA256" \
    "$RESOLVED_GIT_EXTENSION_VERSION" \
    "$RESOLVED_GIT_EXTENSION_MANIFEST_HASH" \
    "$RESOLVED_GIT_EXTENSION_TREE_SHA256" \
    "$RESOLVED_WORKFLOW_VERSION" \
    "$RESOLVED_WORKFLOW_SHA256" \
    "$RESOLVED_WORKFLOW_SOURCE" \
    "$ponytail_enabled" \
    "$ponytail_version" \
    "$ponytail_ref" \
    "$ponytail_marketplace_sha256" \
    "$RESOLVED_PROJECT_SKILLS_MANIFEST" <<'PY'
import json
import os
import sys
import tempfile
from pathlib import Path

path = Path(sys.argv[1])
data = {
    "schema_version": 3,
    "bootstrap_version": sys.argv[2],
    "spec_kit": {
        "version": sys.argv[3],
        "ref": sys.argv[4],
        "source": f"git+https://github.com/github/spec-kit.git@{sys.argv[4]}",
    },
    "github_issue_canon": {
        "version": sys.argv[5],
        "ref": sys.argv[6],
        "installed_version": sys.argv[7],
        "source_url": sys.argv[8],
        "archive_sha256": sys.argv[9],
        "manifest_hash": sys.argv[10],
        "tree_sha256": sys.argv[11],
    },
    "extensions": {
        "agent_context": {
            "version": sys.argv[12],
            "manifest_hash": sys.argv[13],
            "tree_sha256": sys.argv[14],
        },
        "git": {
            "version": sys.argv[15],
            "manifest_hash": sys.argv[16],
            "tree_sha256": sys.argv[17],
        },
    },
    "workflow": {
        "id": "speckit",
        "version": sys.argv[18],
        "sha256": sys.argv[19],
        "source_url": sys.argv[20],
    },
    "ponytail": {
        "enabled": sys.argv[21] == "true",
        "version": sys.argv[22],
        "ref": sys.argv[23],
        "marketplace_sha256": sys.argv[24],
    },
    "project_skills": json.loads(sys.argv[25]),
}
content = json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
path.parent.mkdir(parents=True, exist_ok=True)
if path.exists() and path.read_text(encoding="utf-8") == content:
    raise SystemExit(0)
fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(content)
    os.replace(tmp_name, path)
except BaseException:
    Path(tmp_name).unlink(missing_ok=True)
    raise
PY

  echo "speckit-bootstrap: wrote reproducibility lock at ${path#"$PROJECT_DIR"/}"
}

print_plan() {
  local ponytail="skipped"
  if [[ "$SKIP_PONYTAIL" -eq 0 ]]; then
    ponytail="$RESOLVED_PONYTAIL_VERSION"
  fi

  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    python3 - \
      "$PROJECT_DIR" \
      "$RESOLVED_SPEC_KIT_VERSION" \
      "$RESOLVED_SPEC_KIT_REF" \
      "$RESOLVED_ISSUE_CANON_VERSION" \
      "$RESOLVED_ISSUE_CANON_REF" \
      "$RESOLVED_ISSUE_CANON_URL" \
      "$RESOLVED_ISSUE_CANON_ARCHIVE_SHA256" \
      "$ponytail" \
      "$RESOLVED_PONYTAIL_REF" \
      "$FROZEN" <<'PY' >&"$JSON_OUTPUT_FD"
import json
import sys

print(json.dumps({
    "status": "planned",
    "project": sys.argv[1],
    "frozen": sys.argv[10] == "1",
    "spec_kit": {"version": sys.argv[2], "ref": sys.argv[3]},
    "github_issue_canon": {
        "version": sys.argv[4],
        "ref": sys.argv[5],
        "source_url": sys.argv[6],
        "archive_sha256": sys.argv[7],
    },
    "ponytail": {"version": sys.argv[8], "ref": sys.argv[9]},
}, ensure_ascii=False, sort_keys=True))
PY
    return
  fi

  echo "speckit-bootstrap: dry-run plan"
  echo "  project: $PROJECT_DIR"
  echo "  frozen: $([[ "$FROZEN" -eq 1 ]] && echo yes || echo no)"
  echo "  Spec Kit: $RESOLVED_SPEC_KIT_VERSION"
  echo "  Spec Kit ref: $RESOLVED_SPEC_KIT_REF"
  echo "  github-issue-canon: $RESOLVED_ISSUE_CANON_VERSION"
  echo "  github-issue-canon ref: $RESOLVED_ISSUE_CANON_REF"
  echo "  github-issue-canon source: $RESOLVED_ISSUE_CANON_URL"
  [[ -z "$RESOLVED_ISSUE_CANON_ARCHIVE_SHA256" ]] || \
    echo "  github-issue-canon archive sha256: $RESOLVED_ISSUE_CANON_ARCHIVE_SHA256"
  echo "  Ponytail: $ponytail"
  [[ "$SKIP_PONYTAIL" -eq 1 ]] || echo "  Ponytail ref: $RESOLVED_PONYTAIL_REF"
  echo "  mutations: project .specify/.agents/AGENTS.md/.github, user extension catalog, optional Ponytail plugin"
}

verify_bootstrap() {
  local errors=0
  local path
  local installed
  local installed_ref
  local actual_hash
  local actual_source
  local actual_tree_hash
  local marketplace_info
  local marketplace_type
  local marketplace_source
  local marketplace_target
  local descriptor
  local required=(
    ".specify"
    "AGENTS.md"
    ".specify/speckit-bootstrap.lock.json"
    ".specify/extensions/.registry"
    ".specify/workflows/workflow-registry.json"
    ".specify/workflows/speckit/workflow.yml"
    "docs/agent-guidance/github-issue-canon.md"
    ".github/ISSUE_TEMPLATE/config.yml"
    ".github/ISSUE_TEMPLATE/spec-kit-work-item.yml"
    ".github/pull_request_template.md"
  )

  for path in "${required[@]}"; do
    if [[ ! -e "$PROJECT_DIR/$path" ]]; then
      echo "speckit-bootstrap: doctor missing $path" >&2
      errors=$((errors + 1))
    fi
  done

  if ! grep -Fq '<!-- SPECKIT GITHUB ISSUE START -->' "$PROJECT_DIR/AGENTS.md" 2>/dev/null; then
    echo "speckit-bootstrap: doctor missing managed GitHub instructions" >&2
    errors=$((errors + 1))
  fi
  if ! grep -Fq '<!-- SPECKIT RELEASE VERSIONING START -->' "$PROJECT_DIR/AGENTS.md" 2>/dev/null; then
    echo "speckit-bootstrap: doctor missing release/versioning instructions" >&2
    errors=$((errors + 1))
  fi
  if ! verify_project_skills; then
    echo "speckit-bootstrap: doctor found project skill integrity problems" >&2
    errors=$((errors + 1))
  fi

  if ! command -v specify >/dev/null 2>&1; then
    echo "speckit-bootstrap: doctor did not find the specify CLI" >&2
    errors=$((errors + 1))
  else
    installed="$(normalize_tag "$(specify --version | awk '{print $NF}')")"
    installed_ref="$(installed_spec_kit_ref)"
    if [[ "$RESOLVED_SPEC_KIT_VERSION" == v* && "$installed" != "$RESOLVED_SPEC_KIT_VERSION" ]]; then
      echo "speckit-bootstrap: doctor found specify $installed, expected $RESOLVED_SPEC_KIT_VERSION" >&2
      errors=$((errors + 1))
    fi
    if [[ "$(printf '%s' "$installed_ref" | tr '[:upper:]' '[:lower:]')" != "$(printf '%s' "$RESOLVED_SPEC_KIT_REF" | tr '[:upper:]' '[:lower:]')" ]]; then
      echo "speckit-bootstrap: doctor found specify ref '$installed_ref', expected $RESOLVED_SPEC_KIT_REF" >&2
      errors=$((errors + 1))
    fi
  fi

  if [[ -n "$RESOLVED_AGENT_CONTEXT_VERSION" ]]; then
    installed="$(extension_version agent-context)"
    actual_hash="$(extension_manifest_hash agent-context)"
    actual_tree_hash="$(extension_tree_hash agent-context)"
    if [[ "$installed" != "$RESOLVED_AGENT_CONTEXT_VERSION" ||
          "$actual_hash" != "$RESOLVED_AGENT_CONTEXT_MANIFEST_HASH" ||
          "$actual_tree_hash" != "$RESOLVED_AGENT_CONTEXT_TREE_SHA256" ]]; then
      echo "speckit-bootstrap: doctor found agent-context state that differs from the lock" >&2
      errors=$((errors + 1))
    fi
  fi

  if [[ -n "$RESOLVED_GIT_EXTENSION_VERSION" ]]; then
    installed="$(extension_version git)"
    actual_hash="$(extension_manifest_hash git)"
    actual_tree_hash="$(extension_tree_hash git)"
    if [[ "$installed" != "$RESOLVED_GIT_EXTENSION_VERSION" ||
          "$actual_hash" != "$RESOLVED_GIT_EXTENSION_MANIFEST_HASH" ||
          "$actual_tree_hash" != "$RESOLVED_GIT_EXTENSION_TREE_SHA256" ]]; then
      echo "speckit-bootstrap: doctor found git extension state that differs from the lock" >&2
      errors=$((errors + 1))
    fi
  fi

  if [[ -n "$RESOLVED_ISSUE_CANON_INSTALLED_VERSION" ]]; then
    installed="$(extension_version github-issue-canon)"
    actual_hash="$(extension_manifest_hash github-issue-canon)"
    actual_tree_hash="$(extension_tree_hash github-issue-canon)"
    if [[ "$installed" != "$RESOLVED_ISSUE_CANON_INSTALLED_VERSION" ||
          "$actual_hash" != "$RESOLVED_ISSUE_CANON_MANIFEST_HASH" ||
          "$actual_tree_hash" != "$RESOLVED_ISSUE_CANON_TREE_SHA256" ]]; then
      echo "speckit-bootstrap: doctor found github-issue-canon state that differs from the lock" >&2
      errors=$((errors + 1))
    fi
  fi

  if [[ -n "$RESOLVED_WORKFLOW_VERSION" && -f "$PROJECT_DIR/.specify/workflows/speckit/workflow.yml" ]]; then
    installed="$(workflow_version)"
    actual_hash="$(sha256_path "$PROJECT_DIR/.specify/workflows/speckit/workflow.yml")"
    actual_source="$(workflow_source)"
    if [[ "$installed" != "$RESOLVED_WORKFLOW_VERSION" ||
          "$actual_hash" != "$RESOLVED_WORKFLOW_SHA256" ||
          "$actual_source" != "$RESOLVED_WORKFLOW_SOURCE" ]]; then
      echo "speckit-bootstrap: doctor found speckit workflow state that differs from the lock" >&2
      errors=$((errors + 1))
    fi
  fi

  if [[ "$SKIP_PONYTAIL" -eq 0 ]]; then
    installed="$(installed_ponytail_version)"
    if [[ -z "$installed" ]]; then
      echo "speckit-bootstrap: doctor did not find the Ponytail plugin" >&2
      errors=$((errors + 1))
    elif [[ -n "$RESOLVED_PONYTAIL_VERSION" && "$(normalize_tag "$installed")" != "$RESOLVED_PONYTAIL_VERSION" ]]; then
      echo "speckit-bootstrap: doctor found Ponytail v$installed, expected $RESOLVED_PONYTAIL_VERSION" >&2
      errors=$((errors + 1))
    fi
    installed_ref="$(installed_ponytail_ref)"
    if [[ -n "$RESOLVED_PONYTAIL_REF" && "$installed_ref" != "$RESOLVED_PONYTAIL_REF" ]]; then
      echo "speckit-bootstrap: doctor found Ponytail ref '$installed_ref', expected $RESOLVED_PONYTAIL_REF" >&2
      errors=$((errors + 1))
    fi
    if ! ponytail_marketplace_configured; then
      echo "speckit-bootstrap: doctor did not find the Ponytail marketplace" >&2
      errors=$((errors + 1))
    else
      marketplace_info="$(ponytail_marketplace_info)"
      IFS=$'\t' read -r marketplace_type marketplace_source <<< "$marketplace_info"
      marketplace_target="$(ponytail_managed_marketplace_path)"
      if [[ "$marketplace_type" != "local" || "$marketplace_source" != "$marketplace_target" ]]; then
        echo "speckit-bootstrap: doctor found an unmanaged Ponytail marketplace source" >&2
        errors=$((errors + 1))
      fi
    fi
    descriptor="$(ponytail_managed_marketplace_path)/.agents/plugins/marketplace.json"
    if [[ ! -f "$descriptor" ]]; then
      echo "speckit-bootstrap: doctor did not find the managed Ponytail descriptor" >&2
      errors=$((errors + 1))
    else
      actual_hash="$(sha256_path "$descriptor")"
      if [[ "$(ponytail_descriptor_ref)" != "$RESOLVED_PONYTAIL_REF" ||
            "$actual_hash" != "$RESOLVED_PONYTAIL_MARKETPLACE_SHA256" ]]; then
        echo "speckit-bootstrap: doctor found Ponytail marketplace descriptor drift" >&2
        errors=$((errors + 1))
      fi
    fi
    if [[ ! -f "$PROJECT_DIR/$PONYTAIL_UPSTREAM_AGENTS_PATH" ]]; then
      echo "speckit-bootstrap: doctor missing $PONYTAIL_UPSTREAM_AGENTS_PATH" >&2
      errors=$((errors + 1))
    fi
    if ! grep -Fq '<!-- SPECKIT PONYTAIL START -->' "$PROJECT_DIR/AGENTS.md" 2>/dev/null; then
      echo "speckit-bootstrap: doctor missing Ponytail instructions" >&2
      errors=$((errors + 1))
    fi
  fi

  if [[ "$TRACK_INSTALL_METADATA" == "1" ]] && \
     git -C "$PROJECT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git -C "$PROJECT_DIR" ls-files -v \
      "${INSTALL_METADATA_PATHS[@]}" | grep -q '^S '; then
      echo "speckit-bootstrap: doctor found hidden metadata in audit mode" >&2
      errors=$((errors + 1))
    fi
  fi

  if [[ "$errors" -ne 0 ]]; then
    explain_hidden_install_metadata_drift
    echo "speckit-bootstrap: doctor failed with $errors problem(s)" >&2
    return 1
  fi

  echo "speckit-bootstrap: doctor OK"
}

print_final_summary() {
  local status="$1"
  local ponytail="skipped"
  if [[ "$SKIP_PONYTAIL" -eq 0 ]]; then
    ponytail="$PONYTAIL_PLUGIN_STATUS"
  fi

  if [[ "$OUTPUT_JSON" -eq 1 ]]; then
    python3 - \
      "$status" \
      "$BOOTSTRAP_VERSION" \
      "$PROJECT_DIR" \
      "$RESOLVED_SPEC_KIT_VERSION" \
      "$RESOLVED_SPEC_KIT_REF" \
      "$RESOLVED_ISSUE_CANON_VERSION" \
      "$RESOLVED_ISSUE_CANON_REF" \
      "$ponytail" \
      "$RESOLVED_PONYTAIL_REF" \
      "$PONYTAIL_UPSTREAM_AGENTS_STATUS" <<'PY' >&"$JSON_OUTPUT_FD"
import json
import sys

print(json.dumps({
    "status": sys.argv[1],
    "bootstrap_version": sys.argv[2],
    "project": sys.argv[3],
    "spec_kit": {"version": sys.argv[4], "ref": sys.argv[5]},
    "github_issue_canon": {"version": sys.argv[6], "ref": sys.argv[7]},
    "ponytail": {"status": sys.argv[8], "ref": sys.argv[9]},
    "ponytail_guidance": sys.argv[10],
}, ensure_ascii=False, sort_keys=True))
PY
    return
  fi

  echo
  echo "speckit-bootstrap: $status"
  echo "  bootstrap: v$BOOTSTRAP_VERSION"
  echo "  project: $PROJECT_DIR"
  [[ -z "$RESOLVED_SPEC_KIT_VERSION" ]] || echo "  Spec Kit: $RESOLVED_SPEC_KIT_VERSION"
  [[ -z "$RESOLVED_SPEC_KIT_REF" ]] || echo "  Spec Kit ref: $RESOLVED_SPEC_KIT_REF"
  [[ -z "$RESOLVED_ISSUE_CANON_VERSION" ]] || echo "  github-issue-canon: $RESOLVED_ISSUE_CANON_VERSION"
  [[ -z "$RESOLVED_ISSUE_CANON_REF" ]] || echo "  github-issue-canon ref: $RESOLVED_ISSUE_CANON_REF"
  echo "  project skills: $PROJECT_DIR/.agents/skills/speckit-*"
  echo "  ponytail: $ponytail"
  [[ -z "$RESOLVED_PONYTAIL_REF" ]] || echo "  ponytail ref: $RESOLVED_PONYTAIL_REF"
  echo "  ponytail upstream AGENTS.md: $PONYTAIL_UPSTREAM_AGENTS_STATUS"
}

configure_machine_output() {
  [[ "$OUTPUT_JSON" -eq 1 ]] || return 0
  exec 3>&1
  exec 1>&2
  JSON_OUTPUT_FD=3
}

main() {
  parse_args "$@"

  case "$MODE" in
    help)
      usage
      return 0
      ;;
    version)
      printf 'speckit-bootstrap %s\n' "$BOOTSTRAP_VERSION"
      return 0
      ;;
  esac

  configure_machine_output

  require_cmd git
  require_cmd python3
  require_safe_managed_paths

  if [[ "$MODE" == "doctor" ]]; then
    cd "$PROJECT_DIR"
    if [[ -f "$(lock_file)" ]]; then
      if [[ "$(read_lock_value "$(lock_file)" schema_version)" != "3" ]]; then
        echo "speckit-bootstrap: unsupported lock schema in $(lock_file); run once without --frozen to migrate" >&2
        return 1
      fi
      RESOLVED_SPEC_KIT_VERSION="$(read_lock_value "$(lock_file)" spec_kit.version)"
      RESOLVED_SPEC_KIT_REF="$(read_lock_value "$(lock_file)" spec_kit.ref)"
      RESOLVED_ISSUE_CANON_VERSION="$(read_lock_value "$(lock_file)" github_issue_canon.version)"
      RESOLVED_ISSUE_CANON_REF="$(read_lock_value "$(lock_file)" github_issue_canon.ref)"
      RESOLVED_ISSUE_CANON_INSTALLED_VERSION="$(read_lock_value "$(lock_file)" github_issue_canon.installed_version)"
      RESOLVED_ISSUE_CANON_URL="$(read_lock_value "$(lock_file)" github_issue_canon.source_url)"
      RESOLVED_ISSUE_CANON_MANIFEST_HASH="$(read_lock_value "$(lock_file)" github_issue_canon.manifest_hash)"
      RESOLVED_ISSUE_CANON_TREE_SHA256="$(read_lock_value "$(lock_file)" github_issue_canon.tree_sha256)"
      RESOLVED_AGENT_CONTEXT_VERSION="$(read_lock_value "$(lock_file)" extensions.agent_context.version)"
      RESOLVED_AGENT_CONTEXT_MANIFEST_HASH="$(read_lock_value "$(lock_file)" extensions.agent_context.manifest_hash)"
      RESOLVED_AGENT_CONTEXT_TREE_SHA256="$(read_lock_value "$(lock_file)" extensions.agent_context.tree_sha256)"
      RESOLVED_GIT_EXTENSION_VERSION="$(read_lock_value "$(lock_file)" extensions.git.version)"
      RESOLVED_GIT_EXTENSION_MANIFEST_HASH="$(read_lock_value "$(lock_file)" extensions.git.manifest_hash)"
      RESOLVED_GIT_EXTENSION_TREE_SHA256="$(read_lock_value "$(lock_file)" extensions.git.tree_sha256)"
      RESOLVED_WORKFLOW_VERSION="$(read_lock_value "$(lock_file)" workflow.version)"
      RESOLVED_WORKFLOW_SHA256="$(read_lock_value "$(lock_file)" workflow.sha256)"
      RESOLVED_WORKFLOW_SOURCE="$(read_lock_value "$(lock_file)" workflow.source_url)"
      RESOLVED_PROJECT_SKILLS_MANIFEST="$(read_lock_json "$(lock_file)" project_skills)"
      require_commit_sha "$RESOLVED_SPEC_KIT_REF" "Spec Kit"
      if [[ "$RESOLVED_ISSUE_CANON_REF" != "custom" ]]; then
        require_commit_sha "$RESOLVED_ISSUE_CANON_REF" github-issue-canon
      fi
      if [[ "$(read_lock_value "$(lock_file)" ponytail.enabled)" == "false" ]]; then
        SKIP_PONYTAIL=1
      else
        RESOLVED_PONYTAIL_VERSION="$(read_lock_value "$(lock_file)" ponytail.version)"
        RESOLVED_PONYTAIL_REF="$(read_lock_value "$(lock_file)" ponytail.ref)"
        RESOLVED_PONYTAIL_MARKETPLACE_SHA256="$(read_lock_value "$(lock_file)" ponytail.marketplace_sha256)"
        require_safe_version_tag "$RESOLVED_PONYTAIL_VERSION" Ponytail
        require_commit_sha "$RESOLVED_PONYTAIL_REF" Ponytail
        PONYTAIL_PLUGIN_STATUS="installed"
        [[ ! -f "$PROJECT_DIR/$PONYTAIL_UPSTREAM_AGENTS_PATH" ]] || PONYTAIL_UPSTREAM_AGENTS_STATUS="synced"
      fi
    fi
    if verify_bootstrap; then
      print_final_summary ready
      return 0
    fi
    print_final_summary failed
    return 1
  fi

  prepare_versions

  if [[ "$DRY_RUN" -eq 1 ]]; then
    print_plan
    return 0
  fi

  install_cli
  require_cmd specify
  ensure_user_extension_catalog
  ensure_ponytail_codex_plugin

  cd "$PROJECT_DIR"

  if [[ ! -d ".specify" ]]; then
    echo "speckit-bootstrap: initializing Spec Kit in $PROJECT_DIR"
    init_spec_kit_project
  else
    echo "speckit-bootstrap: updating Spec Kit in $PROJECT_DIR"
  fi

  if [[ "$FROZEN" -eq 1 ]]; then
    ensure_codex_integration
    echo "speckit-bootstrap: frozen mode preserved the locked workflow and extensions"
  else
    refresh_speckit_workflow
  fi

  if [[ "$FROZEN" -eq 1 ]]; then
    verify_locked_workflow
    verify_locked_extension \
      agent-context \
      "$RESOLVED_AGENT_CONTEXT_VERSION" \
      "$RESOLVED_AGENT_CONTEXT_MANIFEST_HASH" \
      "$RESOLVED_AGENT_CONTEXT_TREE_SHA256" \
      ".agents/skills/speckit-agent-context-update/SKILL.md"
    verify_locked_extension \
      git \
      "$RESOLVED_GIT_EXTENSION_VERSION" \
      "$RESOLVED_GIT_EXTENSION_MANIFEST_HASH" \
      "$RESOLVED_GIT_EXTENSION_TREE_SHA256" \
      ".agents/skills/speckit-git-feature/SKILL.md"
    verify_locked_extension \
      github-issue-canon \
      "$RESOLVED_ISSUE_CANON_INSTALLED_VERSION" \
      "$RESOLVED_ISSUE_CANON_MANIFEST_HASH" \
      "$RESOLVED_ISSUE_CANON_TREE_SHA256" \
      ".agents/skills/speckit-github-issue-canon-ensure/SKILL.md"
  else
    ensure_extension agent-context ".agents/skills/speckit-agent-context-update/SKILL.md"
    ensure_extension git ".agents/skills/speckit-git-feature/SKILL.md"
    specify extension update agent-context
    specify extension update git
    if [[ "$ISSUE_CANON_INSTALL_FROM_CATALOG" -eq 1 ]]; then
      ensure_extension_from_catalog \
        github-issue-canon \
        "$RESOLVED_ISSUE_CANON_VERSION" \
        ".agents/skills/speckit-github-issue-canon-ensure/SKILL.md"
    else
      ensure_extension_from_url \
        github-issue-canon \
        "$RESOLVED_ISSUE_CANON_URL" \
        "$RESOLVED_ISSUE_CANON_VERSION" \
        ".agents/skills/speckit-github-issue-canon-ensure/SKILL.md"
    fi
    # Extensions contribute Codex skills. Regenerate once after the full set is
    # installed so a fresh project already matches its subsequent update state.
    ensure_codex_integration
  fi

  ensure_agent_context_config
  configure_git_auto_commit
  ensure_risk_lane_templates
  run_agent_context_update
  ensure_issue_canon_project_files
  ensure_github_agent_instructions
  ensure_release_versioning_instructions
  ensure_ponytail_upstream_agents
  ensure_ponytail_agent_instructions

  if [[ "$FROZEN" -eq 0 ]]; then
    capture_project_dependency_state
    capture_project_skills_state
    migrate_legacy_global_skills
  fi
  clean_caches
  write_lock_file
  hide_install_metadata_diffs

  specify self check
  verify_bootstrap
  print_final_summary ready
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
