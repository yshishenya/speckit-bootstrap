#!/usr/bin/env bash
set -euo pipefail

BOOTSTRAP_VERSION="0.8.1"

usage() {
  cat <<'EOF'
Usage: speckit-bootstrap [PROJECT_DIR] [OPTIONS]

Bootstraps GitHub Spec Kit for Codex in one command:
  - installs/updates official specify-cli from github/spec-kit
  - initializes or updates project-local .specify state
  - installs official core workflow and extensions
  - configures safe git auto-commit defaults for Spec Kit doc stages
  - keeps generated speckit-* skills project-local in .agents/skills
  - optionally installs/updates the Ponytail Codex plugin and project guidance

Modes:
  --doctor                  Verify the current installation without changing it.
  --dry-run                 Resolve versions and print the planned changes only.
  --version                 Print the bootstrap version and exit.

Options:
  --frozen                  Use versions from .specify/speckit-bootstrap.lock.json.
  --json                    Print a machine-readable final summary.
  --keep-local-skills       Deprecated no-op; project-local skills are always kept.
  --skip-cli-update         Use the currently installed specify CLI.
  --skip-ponytail           Skip Ponytail plugin and guidance updates.
  --with-ponytail           Install/update Ponytail plugin and project guidance.

Environment:
  SPEC_KIT_VERSION=vX.Y.Z   Optional pin for reproducible rollbacks.
                            Default: resolve and install latest v* tag.
  SPECKIT_GITHUB_ISSUE_CANON_URL
                            Optional ZIP URL for the reusable GitHub Issue
                            Canon extension. Default: resolved release tag.
  SPECKIT_EXTENSION_CATALOG_URL
                            Optional catalog URL for Yan's approved Spec Kit
                            extensions. Default: yshishenya/main catalog.
  SPECKIT_GITHUB_ISSUE_CANON_VERSION
                            Optional github-issue-canon tag. Default: latest v* tag.
  SPECKIT_PONYTAIL_VERSION  Optional Ponytail tag. Default: latest v* tag.
  SPECKIT_TRACK_INSTALL_METADATA=1
                            Keep Spec Kit install/version metadata visible in git.
                            Default: hide refresh-only metadata with skip-worktree.
  SPECKIT_PONYTAIL=1        Install/update Ponytail plugin and AGENTS.md guidance.
                            Default: disabled; manage user plugins separately.
EOF
}

PROJECT_DIR=""
SKIP_CLI_UPDATE=0
SKIP_PONYTAIL=1
MODE="apply"
DRY_RUN=0
FROZEN=0
OUTPUT_JSON=0
RESOLVED_SPEC_KIT_VERSION=""
RESOLVED_SPEC_KIT_REF=""
RESOLVED_ISSUE_CANON_VERSION=""
RESOLVED_ISSUE_CANON_REF=""
RESOLVED_ISSUE_CANON_INSTALLED_VERSION=""
RESOLVED_ISSUE_CANON_URL=""
RESOLVED_ISSUE_CANON_CATALOG_URL=""
RESOLVED_ISSUE_CANON_ARCHIVE_SHA256=""
RESOLVED_ISSUE_CANON_MANIFEST_HASH=""
RESOLVED_PONYTAIL_VERSION=""
RESOLVED_PONYTAIL_REF=""
RESOLVED_PONYTAIL_MARKETPLACE_SHA256=""
RESOLVED_AGENT_CONTEXT_VERSION=""
RESOLVED_AGENT_CONTEXT_MANIFEST_HASH=""
RESOLVED_AGENT_CONTEXT_TREE_SHA256=""
RESOLVED_GIT_EXTENSION_VERSION=""
RESOLVED_GIT_EXTENSION_MANIFEST_HASH=""
RESOLVED_GIT_EXTENSION_TREE_SHA256=""
RESOLVED_ISSUE_CANON_TREE_SHA256=""
RESOLVED_WORKFLOW_VERSION=""
RESOLVED_WORKFLOW_SHA256=""
RESOLVED_PROJECT_SKILLS_MANIFEST="{}"
RESOLVED_WORKFLOW_SOURCE=""
PONYTAIL_PLUGIN_STATUS="skipped"
JSON_OUTPUT_FD=1
ISSUE_CANON_INSTALL_FROM_CATALOG=0
YAN_EXTENSION_CATALOG_URL="${SPECKIT_EXTENSION_CATALOG_URL:-https://raw.githubusercontent.com/yshishenya/spec-kit-ext-github-issue-canon/main/catalog.json}"
GITHUB_ISSUE_CANON_EXTENSION_URL="${SPECKIT_GITHUB_ISSUE_CANON_URL:-}"
PONYTAIL_UPSTREAM_AGENTS_PATH="docs/agent-guidance/ponytail-upstream.md"
PONYTAIL_UPSTREAM_AGENTS_STATUS="skipped"
TRACK_INSTALL_METADATA="${SPECKIT_TRACK_INSTALL_METADATA:-0}"
INSTALL_METADATA_PATHS=(
  ".specify/init-options.json"
  ".specify/integration.json"
  ".specify/integrations/speckit.manifest.json"
  ".specify/integrations/codex.manifest.json"
  ".specify/extensions/.registry"
  ".specify/workflows/workflow-registry.json"
)

parse_args() {
  case "${SPECKIT_PONYTAIL:-0}" in
    1|true|True|TRUE|yes|Yes|YES|on|On|ON)
      SKIP_PONYTAIL=0
      ;;
  esac

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --doctor)
        MODE="doctor"
        shift
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      --frozen)
        FROZEN=1
        shift
        ;;
      --json)
        OUTPUT_JSON=1
        shift
        ;;
      --keep-local-skills)
        shift
        ;;
      --skip-cli-update)
        SKIP_CLI_UPDATE=1
        shift
        ;;
      --skip-ponytail)
        SKIP_PONYTAIL=1
        shift
        ;;
      --with-ponytail)
        SKIP_PONYTAIL=0
        shift
        ;;
      --version)
        MODE="version"
        shift
        ;;
      -h|--help)
        MODE="help"
        shift
        ;;
      -*)
        echo "speckit-bootstrap: unknown option: $1" >&2
        usage >&2
        return 2
        ;;
      *)
        if [[ -n "$PROJECT_DIR" ]]; then
          echo "speckit-bootstrap: PROJECT_DIR already set to '$PROJECT_DIR'" >&2
          return 2
        fi
        PROJECT_DIR="$1"
        shift
        ;;
    esac
  done

  if [[ "$MODE" == "version" || "$MODE" == "help" ]]; then
    return 0
  fi

  PROJECT_DIR="${PROJECT_DIR:-$PWD}"
  if [[ ! -d "$PROJECT_DIR" ]]; then
    echo "speckit-bootstrap: project directory does not exist: $PROJECT_DIR" >&2
    return 2
  fi
  PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "speckit-bootstrap: required command not found: $1" >&2
    exit 1
  fi
}

canonical_path() {
  python3 - "$1" <<'PY'
import os
import sys

print(os.path.realpath(sys.argv[1]))
PY
}

require_safe_managed_paths() {
  local relative path
  local -a managed_paths=(
    ".specify"
    ".specify/speckit-bootstrap.lock.json"
    ".specify/extensions"
    ".specify/extensions/.registry"
    ".specify/extensions/agent-context"
    ".specify/extensions/git"
    ".specify/extensions/github-issue-canon"
    ".specify/integrations"
    ".specify/scripts"
    ".specify/templates"
    ".specify/templates/plan-template.md"
    ".specify/templates/tasks-template.md"
    ".specify/workflows"
    ".specify/workflows/workflow-registry.json"
    ".specify/workflows/speckit"
    ".specify/workflows/speckit/workflow.yml"
    ".agents"
    ".agents/skills"
    ".github"
    ".github/ISSUE_TEMPLATE"
    ".github/ISSUE_TEMPLATE/config.yml"
    ".github/ISSUE_TEMPLATE/spec-kit-work-item.yml"
    ".github/pull_request_template.md"
    "docs"
    "docs/agent-guidance"
    "docs/agent-guidance/github-issue-canon.md"
    "docs/agent-guidance/ponytail-upstream.md"
    "AGENTS.md"
  )

  for relative in "${managed_paths[@]}"; do
    path="$PROJECT_DIR/$relative"
    if [[ -L "$path" ]]; then
      echo "speckit-bootstrap: managed project path must not be a symlink: $relative" >&2
      return 1
    fi
  done

  for path in "$PROJECT_DIR/.agents/skills"/speckit-*; do
    [[ -e "$path" || -L "$path" ]] || continue
    if [[ -L "$path" ]]; then
      echo "speckit-bootstrap: managed project skill must not be a symlink: ${path#"$PROJECT_DIR/"}" >&2
      return 1
    fi
  done
}

resolve_latest_tag() {
  local repository_url="$1"

  git ls-remote --tags --sort='v:refname' "$repository_url" 'refs/tags/v*' |
    sed -n 's#.*refs/tags/\(v[^^]*\)$#\1#p' |
    tail -1
}

resolve_tag_commit() {
  local repository_url="$1"
  local tag="$2"
  local commit
  commit="$(git ls-remote --tags "$repository_url" \
    "refs/tags/$tag" "refs/tags/$tag^{}" | \
    awk '$2 ~ /\^\{\}$/ {print $1; found=1; exit} NR == 1 {fallback=$1} END {if (!found) print fallback}')"
  if [[ ! "$commit" =~ ^[0-9a-fA-F]{40}$ ]]; then
    echo "speckit-bootstrap: could not resolve immutable commit for $repository_url@$tag" >&2
    return 1
  fi
  printf '%s\n' "$commit"
}

resolve_spec_kit_version() {
  local requested="${SPEC_KIT_VERSION:-latest}"
  if [[ "$requested" == "latest" ]]; then
    resolve_latest_tag https://github.com/github/spec-kit.git
    return
  fi
  if [[ "$requested" == v* || "$requested" =~ ^[0-9a-fA-F]{40}$ ]]; then
    printf '%s\n' "$requested"
    return
  fi

  local resolved
  resolved="$(git ls-remote https://github.com/github/spec-kit.git \
    "$requested" "refs/heads/$requested" "refs/tags/$requested" | awk 'NR == 1 {print $1}')"
  if [[ -z "$resolved" ]]; then
    echo "speckit-bootstrap: could not resolve Spec Kit ref '$requested'" >&2
    return 1
  fi
  printf '%s\n' "$resolved"
}

normalize_tag() {
  case "$1" in
    v*) printf '%s\n' "$1" ;;
    *) printf 'v%s\n' "$1" ;;
  esac
}

resolve_issue_canon_catalog_entry() {
  python3 - "$YAN_EXTENSION_CATALOG_URL" <<'PY'
import json
import re
import sys
import time
import urllib.error
import urllib.request
from urllib.parse import urlparse

catalog_url = sys.argv[1]
try:
    for attempt in range(3):
        try:
            with urllib.request.urlopen(catalog_url, timeout=20) as response:
                catalog = json.load(response)
            break
        except (OSError, urllib.error.URLError):
            if attempt == 2:
                raise
            time.sleep(attempt + 1)
    entry = catalog["extensions"]["github-issue-canon"]
    version = str(entry["version"])
    if version.startswith("v"):
        version = version[1:]
    download_url = str(entry["download_url"])
    sha256 = str(entry["sha256"]).lower()
except (OSError, ValueError, KeyError, TypeError, urllib.error.URLError) as error:
    print(
        f"speckit-bootstrap: invalid github-issue-canon catalog entry at "
        f"{catalog_url}: {error}",
        file=sys.stderr,
    )
    raise SystemExit(1)

if not re.fullmatch(r"[0-9A-Za-z][0-9A-Za-z._+-]*", version):
    raise SystemExit("speckit-bootstrap: catalog contains an unsafe github-issue-canon version")
parsed = urlparse(download_url)
if parsed.scheme != "https" or not parsed.hostname:
    raise SystemExit("speckit-bootstrap: catalog github-issue-canon download_url must use HTTPS")
if not re.fullmatch(r"[0-9a-f]{64}", sha256):
    raise SystemExit("speckit-bootstrap: catalog github-issue-canon sha256 is missing or invalid")

print(f"v{version}\t{download_url}\t{sha256}")
PY
}

require_remote_tag() {
  local repository_url="$1"
  local tag="$2"
  if ! git ls-remote --exit-code --tags "$repository_url" "refs/tags/$tag" >/dev/null; then
    echo "speckit-bootstrap: tag $tag does not exist in $repository_url" >&2
    return 1
  fi
}

require_safe_version_tag() {
  local tag="$1"
  local label="$2"
  if [[ ! "$tag" =~ ^v[0-9A-Za-z][0-9A-Za-z._+-]*$ ]]; then
    echo "speckit-bootstrap: unsafe $label tag: $tag" >&2
    return 1
  fi
}

require_commit_sha() {
  local commit="$1"
  local label="$2"
  if [[ ! "$commit" =~ ^[0-9a-fA-F]{40}$ ]]; then
    echo "speckit-bootstrap: invalid $label commit SHA: $commit" >&2
    return 1
  fi
}

lock_file() {
  printf '%s/.specify/speckit-bootstrap.lock.json\n' "$PROJECT_DIR"
}

read_lock_value() {
  local path="$1"
  local key="$2"

  python3 - "$path" "$key" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    value = json.loads(path.read_text(encoding="utf-8"))
    for part in sys.argv[2].split("."):
        value = value[part]
except (OSError, json.JSONDecodeError, KeyError, TypeError) as error:
    print(f"speckit-bootstrap: invalid lock file {path}: {error}", file=sys.stderr)
    raise SystemExit(1)
if isinstance(value, bool):
    print("true" if value else "false")
else:
    print(value)
PY
}

read_lock_json() {
  local path="$1"
  local key="$2"

  python3 - "$path" "$key" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
try:
    value = json.loads(path.read_text(encoding="utf-8"))
    for part in sys.argv[2].split("."):
        value = value[part]
except (OSError, json.JSONDecodeError, KeyError, TypeError) as error:
    print(f"speckit-bootstrap: invalid lock file {path}: {error}", file=sys.stderr)
    raise SystemExit(1)
print(json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":")))
PY
}

prepare_versions() {
  local lock
  lock="$(lock_file)"

  if [[ "$FROZEN" -eq 1 ]]; then
    if [[ ! -f "$lock" ]]; then
      echo "speckit-bootstrap: --frozen requires $lock" >&2
      return 1
    fi
    if [[ "$(read_lock_value "$lock" schema_version)" != "3" ]]; then
      echo "speckit-bootstrap: unsupported lock schema in $lock; run once without --frozen to migrate" >&2
      return 1
    fi
    RESOLVED_SPEC_KIT_VERSION="$(read_lock_value "$lock" spec_kit.version)"
    RESOLVED_SPEC_KIT_REF="$(read_lock_value "$lock" spec_kit.ref)"
    RESOLVED_ISSUE_CANON_VERSION="$(read_lock_value "$lock" github_issue_canon.version)"
    RESOLVED_ISSUE_CANON_REF="$(read_lock_value "$lock" github_issue_canon.ref)"
    RESOLVED_ISSUE_CANON_INSTALLED_VERSION="$(read_lock_value "$lock" github_issue_canon.installed_version)"
    RESOLVED_ISSUE_CANON_URL="$(read_lock_value "$lock" github_issue_canon.source_url)"
    RESOLVED_ISSUE_CANON_MANIFEST_HASH="$(read_lock_value "$lock" github_issue_canon.manifest_hash)"
    RESOLVED_ISSUE_CANON_TREE_SHA256="$(read_lock_value "$lock" github_issue_canon.tree_sha256)"
    RESOLVED_AGENT_CONTEXT_VERSION="$(read_lock_value "$lock" extensions.agent_context.version)"
    RESOLVED_AGENT_CONTEXT_MANIFEST_HASH="$(read_lock_value "$lock" extensions.agent_context.manifest_hash)"
    RESOLVED_AGENT_CONTEXT_TREE_SHA256="$(read_lock_value "$lock" extensions.agent_context.tree_sha256)"
    RESOLVED_GIT_EXTENSION_VERSION="$(read_lock_value "$lock" extensions.git.version)"
    RESOLVED_GIT_EXTENSION_MANIFEST_HASH="$(read_lock_value "$lock" extensions.git.manifest_hash)"
    RESOLVED_GIT_EXTENSION_TREE_SHA256="$(read_lock_value "$lock" extensions.git.tree_sha256)"
    RESOLVED_WORKFLOW_VERSION="$(read_lock_value "$lock" workflow.version)"
    RESOLVED_WORKFLOW_SHA256="$(read_lock_value "$lock" workflow.sha256)"
    RESOLVED_WORKFLOW_SOURCE="$(read_lock_value "$lock" workflow.source_url)"
    RESOLVED_PROJECT_SKILLS_MANIFEST="$(read_lock_json "$lock" project_skills)"
    require_commit_sha "$RESOLVED_SPEC_KIT_REF" "Spec Kit"
    if [[ "$RESOLVED_ISSUE_CANON_REF" != "custom" ]]; then
      require_commit_sha "$RESOLVED_ISSUE_CANON_REF" github-issue-canon
    fi
    if [[ "$(read_lock_value "$lock" ponytail.enabled)" == "false" ]]; then
      SKIP_PONYTAIL=1
    else
      RESOLVED_PONYTAIL_VERSION="$(read_lock_value "$lock" ponytail.version)"
      RESOLVED_PONYTAIL_REF="$(read_lock_value "$lock" ponytail.ref)"
      RESOLVED_PONYTAIL_MARKETPLACE_SHA256="$(read_lock_value "$lock" ponytail.marketplace_sha256)"
      require_safe_version_tag "$RESOLVED_PONYTAIL_VERSION" Ponytail
      require_commit_sha "$RESOLVED_PONYTAIL_REF" Ponytail
    fi
    return 0
  fi

  if [[ "$SKIP_CLI_UPDATE" -eq 1 ]]; then
    require_cmd specify
    RESOLVED_SPEC_KIT_VERSION="$(specify --version | awk '{print $NF}')"
    RESOLVED_SPEC_KIT_VERSION="$(normalize_tag "$RESOLVED_SPEC_KIT_VERSION")"
  else
    RESOLVED_SPEC_KIT_VERSION="$(resolve_spec_kit_version)"
  fi

  if [[ -z "$RESOLVED_SPEC_KIT_VERSION" ]]; then
    echo "speckit-bootstrap: could not resolve github/spec-kit version" >&2
    return 1
  fi
  if [[ "$RESOLVED_SPEC_KIT_VERSION" =~ ^[0-9a-fA-F]{40}$ ]]; then
    RESOLVED_SPEC_KIT_REF="$RESOLVED_SPEC_KIT_VERSION"
  else
    require_safe_version_tag "$RESOLVED_SPEC_KIT_VERSION" "Spec Kit"
    RESOLVED_SPEC_KIT_REF="$(resolve_tag_commit https://github.com/github/spec-kit.git "$RESOLVED_SPEC_KIT_VERSION")"
  fi

  if [[ -n "$GITHUB_ISSUE_CANON_EXTENSION_URL" ]]; then
    RESOLVED_ISSUE_CANON_VERSION="custom"
    RESOLVED_ISSUE_CANON_REF="custom"
    RESOLVED_ISSUE_CANON_URL="$GITHUB_ISSUE_CANON_EXTENSION_URL"
  else
    local requested_canon="${SPECKIT_GITHUB_ISSUE_CANON_VERSION:-latest}"
    local catalog_entry=""
    local catalog_version=""
    local catalog_url=""
    local catalog_sha256=""

    if [[ "$requested_canon" == "latest" ]]; then
      catalog_entry="$(resolve_issue_canon_catalog_entry)"
      IFS=$'\t' read -r catalog_version catalog_url catalog_sha256 <<< "$catalog_entry"
      RESOLVED_ISSUE_CANON_VERSION="$catalog_version"
      RESOLVED_ISSUE_CANON_URL="$catalog_url"
      RESOLVED_ISSUE_CANON_ARCHIVE_SHA256="$catalog_sha256"
      ISSUE_CANON_INSTALL_FROM_CATALOG=1
    else
      RESOLVED_ISSUE_CANON_VERSION="$(normalize_tag "$requested_canon")"
      if [[ -n "${SPECKIT_EXTENSION_CATALOG_URL:-}" ]]; then
        catalog_entry="$(resolve_issue_canon_catalog_entry)"
        IFS=$'\t' read -r catalog_version catalog_url catalog_sha256 <<< "$catalog_entry"
        if [[ "$RESOLVED_ISSUE_CANON_VERSION" == "$catalog_version" ]]; then
          RESOLVED_ISSUE_CANON_URL="$catalog_url"
          RESOLVED_ISSUE_CANON_ARCHIVE_SHA256="$catalog_sha256"
          ISSUE_CANON_INSTALL_FROM_CATALOG=1
        fi
      fi
    fi
    if [[ -z "$RESOLVED_ISSUE_CANON_VERSION" ]]; then
      echo "speckit-bootstrap: could not resolve github-issue-canon version" >&2
      return 1
    fi
    require_safe_version_tag "$RESOLVED_ISSUE_CANON_VERSION" github-issue-canon
    require_remote_tag \
      https://github.com/yshishenya/spec-kit-ext-github-issue-canon.git \
      "$RESOLVED_ISSUE_CANON_VERSION"
    RESOLVED_ISSUE_CANON_REF="$(resolve_tag_commit \
      https://github.com/yshishenya/spec-kit-ext-github-issue-canon.git \
      "$RESOLVED_ISSUE_CANON_VERSION")"
    if [[ -z "${SPECKIT_EXTENSION_CATALOG_URL:-}" ]]; then
      local pinned_catalog_url
      local pinned_catalog_entry
      pinned_catalog_url="https://raw.githubusercontent.com/yshishenya/spec-kit-ext-github-issue-canon/$RESOLVED_ISSUE_CANON_REF/catalog.json"
      pinned_catalog_entry="$(YAN_EXTENSION_CATALOG_URL="$pinned_catalog_url" resolve_issue_canon_catalog_entry)"
      IFS=$'\t' read -r catalog_version catalog_url catalog_sha256 <<< "$pinned_catalog_entry"
      if [[ "$catalog_version" != "$RESOLVED_ISSUE_CANON_VERSION" ]]; then
        echo "speckit-bootstrap: tagged github-issue-canon catalog version differs from $RESOLVED_ISSUE_CANON_VERSION" >&2
        return 1
      fi
      if [[ -n "$catalog_entry" && "$pinned_catalog_entry" != "$catalog_entry" ]]; then
        echo "speckit-bootstrap: tagged github-issue-canon catalog differs from the resolved main catalog" >&2
        return 1
      fi
      RESOLVED_ISSUE_CANON_CATALOG_URL="$pinned_catalog_url"
      RESOLVED_ISSUE_CANON_URL="$catalog_url"
      RESOLVED_ISSUE_CANON_ARCHIVE_SHA256="$catalog_sha256"
      ISSUE_CANON_INSTALL_FROM_CATALOG=1
    else
      RESOLVED_ISSUE_CANON_CATALOG_URL="$YAN_EXTENSION_CATALOG_URL"
    fi
    if [[ "$ISSUE_CANON_INSTALL_FROM_CATALOG" -eq 0 ]]; then
      RESOLVED_ISSUE_CANON_URL="https://github.com/yshishenya/spec-kit-ext-github-issue-canon/archive/$RESOLVED_ISSUE_CANON_REF.zip"
    fi
  fi

  if [[ "$SKIP_PONYTAIL" -eq 0 ]]; then
    local requested_ponytail="${SPECKIT_PONYTAIL_VERSION:-latest}"
    if [[ "$requested_ponytail" == "latest" ]]; then
      RESOLVED_PONYTAIL_VERSION="$(resolve_latest_tag https://github.com/DietrichGebert/ponytail.git)"
    else
      RESOLVED_PONYTAIL_VERSION="$(normalize_tag "$requested_ponytail")"
      require_remote_tag \
        https://github.com/DietrichGebert/ponytail.git \
        "$RESOLVED_PONYTAIL_VERSION"
    fi
    if [[ -z "$RESOLVED_PONYTAIL_VERSION" ]]; then
      echo "speckit-bootstrap: could not resolve Ponytail version" >&2
      return 1
    fi
    require_safe_version_tag "$RESOLVED_PONYTAIL_VERSION" Ponytail
    RESOLVED_PONYTAIL_REF="$(resolve_tag_commit \
      https://github.com/DietrichGebert/ponytail.git \
      "$RESOLVED_PONYTAIL_VERSION")"
  fi
}

installed_spec_kit_ref() {
  local specify_bin
  specify_bin="$(command -v specify 2>/dev/null || true)"
  [[ -n "$specify_bin" ]] || return 0

  python3 - "$specify_bin" <<'PY'
import json
import re
import sys
from pathlib import Path

launcher = Path(sys.argv[1])
try:
    first_line = launcher.read_text(encoding="utf-8", errors="ignore").splitlines()[0]
except (OSError, IndexError):
    raise SystemExit(0)

if not first_line.startswith("#!"):
    raise SystemExit(0)
interpreter = first_line[2:].strip()
if not interpreter.startswith("/") or " " in interpreter:
    raise SystemExit(0)

tool_root = Path(interpreter).parent.parent
candidates = sorted(tool_root.glob("lib/python*/site-packages/specify_cli-*.dist-info/direct_url.json"))
for candidate in candidates:
    try:
        data = json.loads(candidate.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        continue
    url = data.get("url", "")
    if url.endswith(".git"):
        url = url[:-4]
    commit = data.get("vcs_info", {}).get("commit_id", "")
    if url == "https://github.com/github/spec-kit" and re.fullmatch(r"[0-9a-fA-F]{40}", commit):
        print(commit.lower())
        break
PY
}

install_cli() {
  local installed=""
  local installed_ref=""
  local expected_ref

  if [[ "$SKIP_CLI_UPDATE" -eq 1 ]]; then
    require_cmd specify
    if [[ "$FROZEN" -eq 1 ]]; then
      installed="$(normalize_tag "$(specify --version | awk '{print $NF}')")"
      installed_ref="$(installed_spec_kit_ref)"
      expected_ref="$(printf '%s' "$RESOLVED_SPEC_KIT_REF" | tr '[:upper:]' '[:lower:]')"
      if [[ "$RESOLVED_SPEC_KIT_VERSION" == v* && "$installed" != "$RESOLVED_SPEC_KIT_VERSION" ]]; then
        echo "speckit-bootstrap: installed specify $installed does not match frozen $RESOLVED_SPEC_KIT_VERSION" >&2
        return 1
      fi
      if [[ "$installed_ref" != "$expected_ref" ]]; then
        echo "speckit-bootstrap: installed specify ref '$installed_ref' does not match frozen $RESOLVED_SPEC_KIT_REF" >&2
        return 1
      fi
    fi
    return
  fi

  expected_ref="$(printf '%s' "$RESOLVED_SPEC_KIT_REF" | tr '[:upper:]' '[:lower:]')"
  if command -v specify >/dev/null 2>&1; then
    installed="$(specify --version 2>/dev/null | awk '{print $NF}' || true)"
    [[ -z "$installed" ]] || installed="$(normalize_tag "$installed")"
    installed_ref="$(installed_spec_kit_ref)"
    installed_ref="$(printf '%s' "$installed_ref" | tr '[:upper:]' '[:lower:]')"
    if [[ "$installed_ref" == "$expected_ref" ]] && \
       { [[ "$RESOLVED_SPEC_KIT_VERSION" != v* ]] || \
         [[ "$installed" == "$RESOLVED_SPEC_KIT_VERSION" ]]; }; then
      echo "speckit-bootstrap: specify-cli $RESOLVED_SPEC_KIT_VERSION already matches github/spec-kit@$RESOLVED_SPEC_KIT_REF"
      return
    fi
  fi

  require_cmd uv
  echo "speckit-bootstrap: installing specify-cli $RESOLVED_SPEC_KIT_VERSION from github/spec-kit@$RESOLVED_SPEC_KIT_REF"
  uv tool install specify-cli --force \
    --from "git+https://github.com/github/spec-kit.git@$RESOLVED_SPEC_KIT_REF"

  # uv does not add its tool directory to PATH for the current process. Make the
  # freshly installed launcher immediately available, including in clean CI homes.
  local uv_tool_bin
  uv_tool_bin="$(uv tool dir --bin)"
  PATH="$uv_tool_bin:$PATH"
  export PATH
  require_cmd specify
}

installed_ponytail_version() {
  command -v codex >/dev/null 2>&1 || return 0
  codex plugin list --json --available 2>/dev/null | python3 -c '
import json, sys
data = json.load(sys.stdin)
for plugin in data.get("installed", []):
    if plugin.get("pluginId") == "ponytail@ponytail" and plugin.get("installed"):
        print(plugin.get("version", ""))
        break
' 2>/dev/null || true
}

installed_ponytail_ref() {
  command -v codex >/dev/null 2>&1 || return 0
  codex plugin list --json --available 2>/dev/null | python3 -c '
import json, sys
data = json.load(sys.stdin)
for plugin in data.get("installed", []):
    if plugin.get("pluginId") == "ponytail@ponytail" and plugin.get("installed"):
        print(plugin.get("source", {}).get("ref", ""))
        break
' 2>/dev/null || true
}

ponytail_marketplace_configured() {
  codex plugin marketplace list --json 2>/dev/null | python3 -c '
import json, sys
data = json.load(sys.stdin)
raise SystemExit(0 if any(item.get("name") == "ponytail" for item in data.get("marketplaces", [])) else 1)
' 2>/dev/null
}

ponytail_marketplace_info() {
  codex plugin marketplace list --json 2>/dev/null | python3 -c '
import json, sys
data = json.load(sys.stdin)
for item in data.get("marketplaces", []):
    if item.get("name") != "ponytail":
        continue
    source = item.get("marketplaceSource", {})
    print(f"{source.get('"'"'sourceType'"'"', '')}\t{source.get('"'"'source'"'"', '')}")
    break
' 2>/dev/null || true
}

ponytail_git_marketplace_ref() {
  local config="$HOME/.codex/config.toml"
  [[ -f "$config" ]] || return 0
  python3 - "$config" <<'PY'
import sys
from pathlib import Path

section = ""
for raw_line in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines():
    line = raw_line.strip()
    if line.startswith("[") and line.endswith("]"):
        section = line
        continue
    if section != "[marketplaces.ponytail]" or not line.startswith("ref"):
        continue
    key, separator, value = line.partition("=")
    if separator and key.strip() == "ref":
        print(value.strip().strip('"').strip("'"))
        break
PY
}

ponytail_managed_marketplace_path() {
  local canonical_home
  canonical_home="$(canonical_path "$HOME")"
  printf '%s/.codex/speckit-bootstrap/marketplaces/ponytail/%s\n' \
    "$canonical_home" "$RESOLVED_PONYTAIL_VERSION"
}

ponytail_descriptor_ref() {
  local descriptor
  descriptor="$(ponytail_managed_marketplace_path)/.agents/plugins/marketplace.json"
  [[ -f "$descriptor" ]] || return 0
  python3 - "$descriptor" <<'PY'
import json
import sys
from pathlib import Path

data = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
for plugin in data.get("plugins", []):
    if plugin.get("name") == "ponytail":
        print(plugin.get("source", {}).get("ref", ""))
        break
PY
}

prepare_managed_ponytail_marketplace() {
  local target
  local descriptor
  local parent
  local build
  local checkout
  local generated
  local actual_sha256
  target="$(ponytail_managed_marketplace_path)"
  descriptor="$target/.agents/plugins/marketplace.json"

  if [[ -f "$descriptor" ]]; then
    actual_sha256="$(sha256_path "$descriptor")"
    if [[ "$(ponytail_descriptor_ref)" != "$RESOLVED_PONYTAIL_REF" ]]; then
      echo "speckit-bootstrap: managed Ponytail descriptor has the wrong plugin ref" >&2
      return 1
    fi
    if [[ "$FROZEN" -eq 1 && "$actual_sha256" != "$RESOLVED_PONYTAIL_MARKETPLACE_SHA256" ]]; then
      echo "speckit-bootstrap: managed Ponytail descriptor does not match the frozen lock" >&2
      return 1
    fi
    RESOLVED_PONYTAIL_MARKETPLACE_SHA256="$actual_sha256"
    return 0
  fi

  parent="$(dirname "$target")"
  mkdir -p "$parent"
  build="$(mktemp -d "$parent/.build.XXXXXX")"
  checkout="$build/upstream"
  generated="$build/marketplace"

  if ! git -c advice.detachedHead=false clone --quiet --depth 1 \
    --branch "$RESOLVED_PONYTAIL_VERSION" \
    https://github.com/DietrichGebert/ponytail.git "$checkout"; then
    rm -rf "$build"
    echo "speckit-bootstrap: failed to fetch Ponytail $RESOLVED_PONYTAIL_VERSION" >&2
    return 1
  fi

  mkdir -p "$generated/.agents/plugins"
  python3 - \
    "$checkout/.agents/plugins/marketplace.json" \
    "$generated/.agents/plugins/marketplace.json" \
    "$RESOLVED_PONYTAIL_REF" <<'PY'
import json
import sys
from pathlib import Path

source = Path(sys.argv[1])
target = Path(sys.argv[2])
source_ref = sys.argv[3]
data = json.loads(source.read_text(encoding="utf-8"))
if data.get("name") != "ponytail":
    raise SystemExit("speckit-bootstrap: upstream Ponytail marketplace name changed")
plugin = next((item for item in data.get("plugins", []) if item.get("name") == "ponytail"), None)
if plugin is None:
    raise SystemExit("speckit-bootstrap: upstream Ponytail plugin entry is missing")
plugin_source = plugin.get("source", {})
if plugin_source.get("source") != "url" or "DietrichGebert/ponytail" not in plugin_source.get("url", ""):
    raise SystemExit("speckit-bootstrap: upstream Ponytail plugin source changed")
plugin_source["ref"] = source_ref
target.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
PY

  actual_sha256="$(sha256_path "$generated/.agents/plugins/marketplace.json")"
  if [[ "$FROZEN" -eq 1 && "$actual_sha256" != "$RESOLVED_PONYTAIL_MARKETPLACE_SHA256" ]]; then
    rm -rf "$build"
    echo "speckit-bootstrap: fetched Ponytail descriptor does not match the frozen lock" >&2
    return 1
  fi

  if ! mv "$generated" "$target"; then
    rm -rf "$build"
    echo "speckit-bootstrap: failed to install managed Ponytail marketplace descriptor" >&2
    return 1
  fi
  rm -rf "$build"
  RESOLVED_PONYTAIL_MARKETPLACE_SHA256="$actual_sha256"
  echo "speckit-bootstrap: prepared managed Ponytail marketplace at $target"
}

restore_ponytail_state() {
  local previous_type="$1"
  local previous_source="$2"
  local previous_ref="$3"
  local had_plugin="$4"
  local -a args

  [[ -n "$previous_source" ]] || return 0
  args=(plugin marketplace add "$previous_source" --json)
  if [[ "$previous_type" == "git" && -n "$previous_ref" ]]; then
    args=(plugin marketplace add "$previous_source" --ref "$previous_ref" --json)
  fi
  codex "${args[@]}" >/dev/null || true
  if [[ "$had_plugin" -eq 1 ]]; then
    codex plugin add ponytail@ponytail --json >/dev/null || true
  fi
}

ensure_ponytail_codex_plugin() {
  [[ "$SKIP_PONYTAIL" -eq 0 ]] || return 0

  if ! command -v codex >/dev/null 2>&1; then
    PONYTAIL_PLUGIN_STATUS="failed"
    echo "speckit-bootstrap: codex CLI is required with --with-ponytail" >&2
    return 1
  fi

  local installed
  local installed_ref
  local target
  local info
  local previous_type=""
  local previous_source=""
  local previous_ref=""
  local had_plugin=0
  local switched=0
  local needs_install=0

  if ! prepare_managed_ponytail_marketplace; then
    PONYTAIL_PLUGIN_STATUS="failed"
    return 1
  fi
  target="$(ponytail_managed_marketplace_path)"
  installed="$(installed_ponytail_version)"
  installed_ref="$(installed_ponytail_ref)"
  if [[ -n "$installed" ]]; then
    had_plugin=1
  fi

  if ponytail_marketplace_configured; then
    info="$(ponytail_marketplace_info)"
    IFS=$'\t' read -r previous_type previous_source <<< "$info"
    previous_ref="$(ponytail_git_marketplace_ref)"
  fi

  if [[ "$previous_source" != "$target" ]]; then
    if [[ "$had_plugin" -eq 1 ]] && ! codex plugin remove ponytail@ponytail --json >/dev/null; then
      PONYTAIL_PLUGIN_STATUS="failed"
      echo "speckit-bootstrap: failed to remove Ponytail before switching marketplace" >&2
      return 1
    fi
    if [[ -n "$previous_source" ]] && ! codex plugin marketplace remove ponytail --json >/dev/null; then
      PONYTAIL_PLUGIN_STATUS="failed"
      echo "speckit-bootstrap: failed to remove the previous Ponytail marketplace" >&2
      [[ "$had_plugin" -eq 0 ]] || codex plugin add ponytail@ponytail --json >/dev/null || true
      return 1
    fi
    if ! codex plugin marketplace add "$target" --json >/dev/null; then
      PONYTAIL_PLUGIN_STATUS="failed"
      echo "speckit-bootstrap: failed to add the managed Ponytail marketplace; restoring previous state" >&2
      restore_ponytail_state "$previous_type" "$previous_source" "$previous_ref" "$had_plugin"
      return 1
    fi
    switched=1
    needs_install=1
  elif [[ -z "$installed" ]]; then
    needs_install=1
  elif [[ "$(normalize_tag "$installed")" != "$RESOLVED_PONYTAIL_VERSION" ||
          "$installed_ref" != "$RESOLVED_PONYTAIL_REF" ]]; then
    echo "speckit-bootstrap: reinstalling Ponytail v$installed for requested $RESOLVED_PONYTAIL_VERSION"
    if ! codex plugin remove ponytail@ponytail --json >/dev/null; then
      PONYTAIL_PLUGIN_STATUS="failed"
      echo "speckit-bootstrap: failed to remove mismatched Ponytail v$installed" >&2
      return 1
    fi
    needs_install=1
  fi

  if [[ "$needs_install" -eq 1 ]] && ! codex plugin add ponytail@ponytail --json >/dev/null; then
    PONYTAIL_PLUGIN_STATUS="failed"
    echo "speckit-bootstrap: failed to install Ponytail Codex plugin" >&2
    if [[ "$switched" -eq 1 ]]; then
      codex plugin marketplace remove ponytail --json >/dev/null || true
      restore_ponytail_state "$previous_type" "$previous_source" "$previous_ref" "$had_plugin"
    fi
    return 1
  fi

  installed="$(installed_ponytail_version)"
  installed_ref="$(installed_ponytail_ref)"
  if [[ -z "$installed" ]]; then
    PONYTAIL_PLUGIN_STATUS="failed"
    echo "speckit-bootstrap: Ponytail install returned success but the plugin is not listed" >&2
    return 1
  fi

  if [[ "$(normalize_tag "$installed")" != "$RESOLVED_PONYTAIL_VERSION" ]]; then
    PONYTAIL_PLUGIN_STATUS="failed"
    echo "speckit-bootstrap: installed Ponytail v$installed does not match requested $RESOLVED_PONYTAIL_VERSION" >&2
    if [[ "$switched" -eq 1 ]]; then
      codex plugin remove ponytail@ponytail --json >/dev/null || true
      codex plugin marketplace remove ponytail --json >/dev/null || true
      restore_ponytail_state "$previous_type" "$previous_source" "$previous_ref" "$had_plugin"
    fi
    return 1
  fi
  if [[ "$installed_ref" != "$RESOLVED_PONYTAIL_REF" ]]; then
    PONYTAIL_PLUGIN_STATUS="failed"
    echo "speckit-bootstrap: installed Ponytail ref '$installed_ref' does not match requested $RESOLVED_PONYTAIL_REF" >&2
    if [[ "$switched" -eq 1 ]]; then
      codex plugin remove ponytail@ponytail --json >/dev/null || true
      codex plugin marketplace remove ponytail --json >/dev/null || true
      restore_ponytail_state "$previous_type" "$previous_source" "$previous_ref" "$had_plugin"
    fi
    return 1
  fi

  PONYTAIL_PLUGIN_STATUS="installed"
  echo "speckit-bootstrap: managed Ponytail marketplace: $target"
  echo "speckit-bootstrap: installed/updated Ponytail Codex plugin v$installed"
  echo "speckit-bootstrap: review Ponytail hooks in Codex with /hooks before relying on them"
}

installed_ponytail_agents_path() {
  local installed
  installed="$(installed_ponytail_version)"
  [[ -n "$installed" ]] || return 1
  printf '%s/.codex/plugins/cache/ponytail/ponytail/%s/AGENTS.md\n' "$HOME" "$installed"
}

ensure_ponytail_upstream_agents() {
  [[ "$SKIP_PONYTAIL" -eq 0 ]] || return 0

  local dest="$PROJECT_DIR/$PONYTAIL_UPSTREAM_AGENTS_PATH"
  local source
  local tmp

  source="$(installed_ponytail_agents_path || true)"
  if [[ -z "$source" || ! -f "$source" ]]; then
    PONYTAIL_UPSTREAM_AGENTS_STATUS="failed"
    echo "speckit-bootstrap: installed Ponytail AGENTS.md was not found in the plugin cache" >&2
    return 1
  fi

  mkdir -p "$(dirname "$dest")"
  tmp="$(mktemp "$(dirname "$dest")/.ponytail-upstream.XXXXXX")"
  {
    cat <<EOF
# Ponytail Upstream AGENTS.md

Generated by \`speckit-bootstrap\` from the installed Ponytail plugin cache.
Version: $RESOLVED_PONYTAIL_VERSION

Do not edit this file manually. Re-run \`speckit-bootstrap\` to refresh it.
Project-specific Spec Kit rules live in the root \`AGENTS.md\` managed blocks.

---

EOF
    cat "$source"
  } > "$tmp"
  mv "$tmp" "$dest"

  PONYTAIL_UPSTREAM_AGENTS_STATUS="synced"
  echo "speckit-bootstrap: refreshed Ponytail upstream AGENTS.md at $PONYTAIL_UPSTREAM_AGENTS_PATH"
}

ensure_user_extension_catalog() {
  local config_dir="$HOME/.specify"
  local config="$config_dir/extension-catalogs.yml"
  mkdir -p "$config_dir"

  ensure_catalog_entry \
    yshishenya \
    "$YAN_EXTENSION_CATALOG_URL" \
    1 \
    true \
    "Yan's approved Spec Kit extensions"
  ensure_catalog_entry \
    default \
    https://raw.githubusercontent.com/github/spec-kit/main/extensions/catalog.json \
    10 \
    true \
    "Built-in catalog of installable extensions"
  ensure_catalog_entry \
    community \
    https://raw.githubusercontent.com/github/spec-kit/main/extensions/catalog.community.json \
    20 \
    false \
    "Community-contributed extensions (discovery only)"

  echo "speckit-bootstrap: merged user extension catalogs at $config"
}

ensure_catalog_entry() {
  local name="$1"
  local url="$2"
  local priority="$3"
  local install_allowed="$4"
  local description="$5"
  local config="$HOME/.specify/extension-catalogs.yml"
  local backup=""
  local existed=0

  if [[ -f "$config" ]] && grep -Fq "$url" "$config"; then
    return 0
  fi

  if [[ -f "$config" ]] && grep -Eq "^[[:space:]]*-?[[:space:]]*name:[[:space:]]*['\"]?${name}['\"]?[[:space:]]*$" "$config"; then
    echo "speckit-bootstrap: preserved user-owned catalog '$name' with a different URL" >&2
    return 0
  fi

  if [[ -f "$config" ]]; then
    existed=1
    backup="$(mktemp)"
    cp "$config" "$backup"
  fi

  local -a args
  args=(extension catalog add "$url" --name "$name" --priority "$priority" --description "$description")
  if [[ "$install_allowed" == "true" ]]; then
    args+=(--install-allowed)
  fi

  if ! SPECIFY_INIT_DIR="$HOME" specify "${args[@]}" >/dev/null; then
    if [[ "$existed" -eq 1 ]]; then
      cp "$backup" "$config"
    else
      rm -f "$config"
    fi
    [[ -z "$backup" ]] || rm -f "$backup"
    echo "speckit-bootstrap: failed to add catalog '$name'; restored the previous config" >&2
    return 1
  fi

  [[ -z "$backup" ]] || rm -f "$backup"
}

